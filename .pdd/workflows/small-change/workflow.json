{
  "version": 1,
  "name": "small-change",
  "overview": "WORKFLOW.md",
  "stages": [
    {
      "id": "scope",
      "kind": "agent",
      "file": "scope.md",
      "protocol": "proposal",
      "requiredRoles": [
        "cases"
      ],
      "approval": "next-advance"
    },
    {
      "id": "change",
      "kind": "agent",
      "file": "change.md",
      "protocol": "work"
    },
    {
      "id": "verify",
      "kind": "agent",
      "file": "verify.md",
      "protocol": "verify"
    },
    {
      "id": "open-pr",
      "kind": "pr",
      "file": "open-pr.md",
      "publication": "verified"
    },
    {
      "id": "wait-merge",
      "kind": "merge",
      "file": "wait-merge.md",
      "prStage": "open-pr"
    }
  ]
