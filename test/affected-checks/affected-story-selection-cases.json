{
  "schema_version": "pdd.native-cases.v1",
  "story_path": "user_stories/affected-story-selection.md",
  "criteria": [
    {
      "id": "AC1",
      "text": "With changes that affect Stories A and B, `pdd test --affected` selects all their test variants and criteria, and sends no Check for known unrelated Story C."
    },
    {
      "id": "AC2",
      "text": "When change scope, ownership or a required dependency relationship is uncertain, affected selection conservatively keeps all Stories that might be affected; with no established target it keeps the full inventory."
    },
    {
      "id": "AC3",
      "text": "Ordinary full and named checks keep their current selection, cache, call limits and recovery behavior. Affected mode accepts no Story operands or `--lf`; rejected combinations have no execution effects."
    }
  ],
  "synthetic": true,
