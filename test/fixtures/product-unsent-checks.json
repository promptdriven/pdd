{
  "schema_version": "pdd.native-unsent-check-cases.v1",
  "story_path": "user_stories/product-unsent-checks.md",
  "criteria": [
    {
      "id": "AC1",
      "text": "After four current server Story passes, a later check on the same files that sends none of its checks keeps server 4 of 4 and slice 1 4 of 13; this holds after a lint hold or a stop before sending, including for saved Check batches without an intent label."
    },
    {
      "id": "AC2",
      "text": "A saved check that was never sent supplies no passing, failing, unknown or stale Story result, even if its saved label says passed or its lint finished; a Story with only unsent checks supplies no result."
    },
    {
      "id": "AC3",
      "text": "When one Story has two selected tests and only one was sent and passed, the incomplete later check neither establishes a whole-Story pass nor erases an earlier pass. An unsent duplicate of an already sent passing test does not make that Story incomplete or failing, and an unsent check for a different Story does not hide a completed Story."
    },
    {
      "id": "AC4",
      "text": "A later sent check that fails, is unknown or lacks a valid matching receipt still cannot pass and can replace an earlier pass, including when another selected test for that Story was never sent."
    },
    {
      "id": "AC5",
      "text": "Source matching uses every originally selected test, including unsent tests; reading this progress makes no Runtime request, authenticates no Runtime user, changes no saved check and starts no workflow."
    }
  ],
  "synthetic": true,
  "execution": "Native-only expected cases. No Runtime interface is added. Expected values come from the reviewed Source policy, not execution output.",
  "boundaries": {
    "reader": "src/runtime-client.mjs#savedStoryEvidence/createSavedStoryEvidenceReader",
    "product": "src/product.mjs#productStatus/productNext"
  },
  "default_input": {
    "root": "/project"
  },
