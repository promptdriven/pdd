    {
      "case": "authentic-four-passes-then-four-unsent-default-product-read",
      "criteria": [
        "AC1",
        "AC2",
        "AC5"
      ],
      "setup": {
        "boundary": "src/runtime-client.mjs#runCheck",
        "seed": "test/fixtures/harbor/tests/place-order.json",
        "product": "Use the existing synthetic coffee product map/plan in test/runtime/product-saved-checks.json; create S01, S02, S03, S04 copies of the Harbor Story/scenario, preserving complete authored criteria/steps and exact original test selection.",
        "first_check": "Use injected deterministic passing lint and complete matching-ID check receipts to produce four genuine current saved passes through runCheck, with no external Runtime.",
        "second_check": "On the same files and exact four tests, use runCheck with injected lint hold or an interrupt after lint but before the first check dispatch. Require every row request_ids to be empty and no Check POST. Retain the original captured source SHA, complete row metadata and lint receipt.",
        "clock": "Use distinct deterministic command times so the unsent producer batch is later than the first batch.",
        "conversion": "Run independently with the produced intent check intact, and with only intent removed from both batches. Do not repair row metadata or synthesize Check receipts for the unsent batch."
      },
      "stop_variants": [
        "lint hold with no Check dispatch",
        "interruption before first Check POST"
      ],
      "independent_operations": [
        "productStatus",
        "productNext"
      ],
      "default_saved_reader": true,
      "expected": {
        "server": {
          "total": 4,
          "pass": 4,
          "stale": 0,
          "notRun": 0
        },
        "slice": {
          "total": 13,
          "pass": 4,
          "stale": 0,
          "notRun": 9
        },
        "runState": "running (step: prompt-story)",
        "journeyReady": false,
        "legacy_hints": 0,
        "saved_check_state_changed": false,
        "runtime_requests_during_read": 0,
        "runtime_auth_during_read": 0,
        "workflow_dispatches_during_read": 0
      }
    },
