        },
        "generated_file": {
          "path": "test/runtime/order.json",
          "prefix": "{\"schema_version\":\"prompt-runtime.program-scenario.v1\",\"padding\":\"",
          "pad_byte": "x",
          "bytes": 1048577,
          "suffix": "\"}"
        }
      },
      "expected": {
        "exit_code": 2,
        "capture_calls": 0,
        "auth_calls": 0,
        "posts": 0,
        "candidate_content_reads": 0,
        "diagnostic_contains": [
          "test/runtime/order.json",
          "1 MiB"
        ]
      }
    },
    {
      "id": "valid-test-outside-conventional-folder",
      "criterion": "AC1",
      "input": {
        "fixture": "harbor",
        "relocate_test_to": "scenarios/order.json",
