{
  "schema_version": "pdd.native-saved-evidence-followup-cases.v1",
  "story_path": "user_stories/product-saved-checks-followup.md",
  "criteria": [
    {
      "id": "AC1",
      "text": "In one product status, next or start command, batches compared with the same folder and selected tests share one source capture even when the test order differs; different folders or test sets use separate captures."
    },
    {
      "id": "AC2",
      "text": "Each batch is compared with its own saved source hash, and a later command captures files again so an edit cannot reuse a previous current result."
    },
    {
      "id": "AC3",
      "text": "Saved Check batches without an intent label count when every saved row has complete original Check information and the existing source and receipt checks pass, including when criterion text metadata is absent but all authored criterion IDs remain in the stored checks; lint, Try and other explicit intents do not count."
    },
    {
      "id": "AC4",
      "text": "Multiple batches without an intent label that lack complete original Check information or complete receipt criterion coverage count no passing Stories and show one hint that older checks are not counted and I should run pdd test again."
    },
    {
      "id": "AC5",
      "text": "A failed source capture can be reused only within that command and leaves its results unverified; the next command retries the capture. Reading saved checks makes no Runtime request, changes no saved check and dispatches no work."
    }
  ],
  "synthetic": true,
  "execution": "Native-only cases; no Runtime interface is added to runtime-client. Expectations are Source requirements, not captured code output.",
  "boundaries": {
    "reader": "src/runtime-client.mjs#createSavedStoryEvidenceReader",
    "savedStoryEvidence": "src/runtime-client.mjs#savedStoryEvidence",
    "product": "src/product.mjs#productStatus/productNext/productStart"
  },
