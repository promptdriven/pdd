  "integration_cases": [
    {
      "case": "authentic-producer-remove-intent-default-product",
      "criteria": [
        "AC3",
        "AC5"
      ],
      "setup": {
        "boundary": "src/runtime-client.mjs#runCheck",
        "seed": "test/fixtures/harbor/tests/place-order.json",
        "replies": "Inject deterministic passing lint and complete matching-ID check receipts for every authored criterion/check; no external Runtime.",
        "product": "Use existing synthetic coffee product map/plan from test/runtime/product-saved-checks.json; create S01, S02, S03, S04 and S010 copies of the Harbor Story/scenario, preserving authored criteria/steps; select those five tests.",
        "conversion": "Read the actual producer batch, remove only intent, and retain every row field, source hash and raw receipt. Do not repair the old owner fixture or fabricate its missing producer fields."
      },
      "operations": [
        "productStatus",
        "productNext"
      ],
      "default_saved_reader": true,
      "expected": {
        "server": {
          "total": 4,
          "pass": 4,
          "stale": 0,
          "notRun": 0
        },
        "slice": {
          "total": 13,
          "pass": 4,
          "stale": 0,
