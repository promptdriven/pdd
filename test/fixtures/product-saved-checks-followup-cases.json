    "fetch",
    "gh auth",
    "Runtime network",
    "saved-check-state writes",
    "saved-check-state directory creation",
    "workflow.start"
  ],
  "permitted_existing_product_effects": [
    "GitHub metadata reads",
    "existing product issue-link cache operations"
  ],
  "forbidden_reader_effects": [
