{
  "schema_version": "pdd.native-cases.v1",
  "story_path": "user_stories/local-contract-evidence.md",
  "criteria": [
    {
      "id": "AC1",
      "text": "I see multiple writers rejected even when they share one table cell, while repeated claims by one writer agree."
    },
    {
      "id": "AC2",
      "text": "I see invalid schema members checked beside metadata, while business annotations and fake resources stay data."
    },
    {
      "id": "AC3",
      "text": "I can check a seed against one record named or linked by its world row and see which declarations have no schema."
    },
    {
      "id": "AC4",
      "text": "I see an advisory when declared records disagree without losing real drift or adding a refusal."
    },
    {
      "id": "AC5",
      "text": "I can declare nested world namespaces with Key or Path and keep exact escaped names and independent ownership."
    },
    {
      "id": "AC6",
      "text": "I get the same warnings and check facts in text and JSON with no service call or source change."
    },
    {
      "id": "AC7",
      "text": "I can compare parsed schemas with the established schema comparison semantics without mutating their values."
    }
  ],
  "boundary": "CLI cases use real runContracts/CLI over safe Git-visible synthetic files; equality cases parse a/b using parseJsonValue then invoke real schemaValuesEqual; no Runtime entry claimed",
  "setup": {
    "git_repository": true,
    "base_files": {},
    "case_files": "Each CLI case starts empty with only set_files, all Git-visible. Execute each in text and JSON. No private fixture data.",
    "observations": "JSON contains exactly exit_code, checked_records, checked_world_values, skipped_files, diagnostics, warnings. Diagnostics use exact supplied provenance projections and nonempty messages. Warnings use exact supplied fields; disagreement messages are nonempty unfixed prose. No extra warnings/diagnostics. Text has the same facts. Schema equality must preserve both serialized parsed input trees byte-for-byte. All filesystem cases preserve source bytes/modes and make zero effect calls. Warning messages are finite nonblank strings, never fixed prose expectations; missing-schema quantities equal the number of unique world_keys. Record-name inference includes recognized valid JSON member records without globally granting copy authority to their siblings. Schema inference requires a known schema link, an exact inline-code record identifier in a non-actor cell, or a whole plain Key/What it holds cell equal to a known name; ordinary prose and path components do not designate records."
  },
