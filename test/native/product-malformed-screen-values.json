{
  "description": "Synthetic native composition cases for the accepted v1 screen-value contract; apply screen_set to the first operation screen of a valid one-part product. These are composition field checks, not Runtime operation/schema admission.",
  "invalid": [
    {
      "id": "prompt_path-null",
      "screen_set": {
        "prompt_path": null
      },
      "expected_error": {
        "code": "invalid-product-map",
        "field": "prompt_path"
      }
    },
    {
      "id": "prompt_path-number",
      "screen_set": {
        "prompt_path": 7
      },
      "expected_error": {
        "code": "invalid-product-map",
        "field": "prompt_path"
      }
    },
    {
      "id": "prompt_path-empty",
      "screen_set": {
        "prompt_path": ""
      },
      "expected_error": {
        "code": "invalid-product-map",
        "field": "prompt_path"
      }
    },
    {
      "id": "operation-null",
