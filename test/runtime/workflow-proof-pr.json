  "criteria": [
    {
      "id": "AC1",
      "text": "A current machine proof for the same run, saved base and current committed head appears as a successful \"Old-code proof:\" line on the code PR."
    },
    {
      "id": "AC2",
      "text": "A current unsuccessful proof remains visible with its actual outcome and does not become a publication gate."
    },
    {
      "id": "AC3",
      "text": "An older committed head is shown as \"stale\"; missing proof is \"not run\"; malformed, foreign-run or foreign-base proof is \"unavailable\". None shows current success."
    },
    {
      "id": "AC4",
      "text": "An agent-written \"Old-code proof:\" line cannot replace missing machine evidence, and the prompt-space PR carries no machine proof line."
    }
  ],
