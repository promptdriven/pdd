{
  "schema_version": "prompt-runtime.program-scenario.v1",
  "story_path": "user_stories/autopilot-base-ports.md",
  "criteria": [
    {
      "id": "AC1",
      "text": "`selectAutopilotBase` reads `autopilot.base` via `config.readConfig`, validates `refs/heads/BRANCH` via `program.execFile`, and raises `invalid-base-branch` for disallowed branch names such as `HEAD`."
    },
    {
      "id": "AC2",
      "text": "`checkAutopilotBase` verifies the PR target, default branch and newest non-draft release ancestry via `program.execFile`, returning exit 0 when `release/next` contains `main` and `v1.2.0` and exit 1 when `release/next` is 2 commits behind `v1.2.0`."
    }
  ],
  "initial_world": {
    "config_counter": 0,
    "exec_counter": 0
  },
