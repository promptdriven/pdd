{
  "schema_version": "prompt-runtime.program-scenario.v1",
  "story_path": "user_stories/workflow-pr-labels.md",
  "criteria": [
    {
      "id": "AC1",
      "text": "Both PRs show nonblank \"Not fixed yet:\", \"Defect:\", \"Not caught because:\", \"Proof (defect fixed):\", \"Proof (gap closed):\" and \"Review:\" lines in that order, with machine proof between the Proof lines and Review on the code PR."
    },
    {
      "id": "AC2",
      "text": "Distinct lines from the latest known-step summaries and direct notes are retained in workflow step order within each label; exact repeats and blank labels are omitted."
    },
    {
      "id": "AC3",
      "text": "Indented labels, different case, labels inside other text, unknown-step notes and agent-written machine proof or inventory lines are not lifted."
    },
    {
      "id": "AC4",
      "text": "When \"Not fixed yet:\" has a nonblank payload, both PRs use \"Refs #2594\"; otherwise PR 1 keeps \"Part of #2594\" and the code PR keeps \"Closes #2594\". Missing labels create no empty placeholders."
    },
    {
      "id": "AC5",
      "text": "Both PRs show nonblank \"Not checked:\" lines immediately after \"Not fixed yet:\" and before \"Defect:\", in latest known-step summary then direct-note order; payload ends are trimmed, internal spaces and distinct lines are retained, and exact repeats are omitted."
    },
    {
      "id": "AC6",
      "text": "Indented, case-varied, embedded and unknown-step \"Not checked:\" lines are omitted, and blank \"Not checked:\" payloads create no placeholders on either PR."
    },
    {
      "id": "AC7",
      "text": "A nonblank \"Not checked:\" line without a nonblank \"Not fixed yet:\" line keeps \"Part of #2594\" on PR 1 and \"Closes #2594\" on the code PR; with both labels, both PRs retain \"Refs #2594\"."
    }
  ],
