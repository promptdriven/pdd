{
  "schema_version": "prompt-runtime.program-scenario.v1",
  "story_path": "user_stories/workflow-pr-labels.md",
  "criteria": [
    {
      "id": "AC1",
      "text": "Both PRs show accepted \"Not fixed yet:\", \"Defect:\", \"Not caught because:\", \"Proof (defect fixed):\", \"Proof (gap closed):\" and \"Review:\" lines in that order, with machine proof between the Proof lines and Review on the code PR; all lifted lines precede every replay status block."
    },
    {
      "id": "AC2",
      "text": "Only authorized writers contribute: build/verify for \"Not fixed yet:\", bug reproduce or small-change scope for \"Defect:\" and \"Not caught because:\", verify for Proof, and the direct review note of an actual review step for \"Review:\". Summary review verdicts and missing-review-step verdicts are omitted; duplicate payloads differing only by one trailing period retain the first spelling."
    },
    {
      "id": "AC3",
      "text": "Indented, case-varied, embedded and unknown-step labels and agent-written machine proof/inventory are not lifted; free-text payloads use control-safe adaptive code spans that neutralize @mentions, issue links and raw ownership-marker text."
    },
    {
      "id": "AC4",
      "text": "When \"Not fixed yet:\" has a nonblank payload, both PRs use \"Refs #2594\"; otherwise PR 1 keeps \"Part of #2594\" and the code PR keeps \"Closes #2594\". Missing labels create no empty placeholders."
    },
    {
      "id": "AC5",
      "text": "Both PRs show accepted \"Not checked:\" lines immediately after \"Not fixed yet:\" and before \"Defect:\", in latest summary then direct-note order for check, try, verify, formal, review and reproduce only; trim payload ends, preserve internal spaces and distinct lines, and deduplicate a single trailing period."
    },
    {
      "id": "AC6",
      "text": "Indented, case-varied, embedded, unknown-step and unauthorized-writer \"Not checked:\" lines are omitted, and blank payloads create no placeholders on either PR."
    },
    {
      "id": "AC7",
      "text": "A nonblank \"Not checked:\" line without a nonblank \"Not fixed yet:\" line keeps \"Part of #2594\" on PR 1 and \"Closes #2594\" on the code PR; with both labels, both PRs retain \"Refs #2594\"."
    }
  ],
