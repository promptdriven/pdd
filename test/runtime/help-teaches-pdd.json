        {"criterion_id": "AC5", "target": "result", "path": "/stdout", "op": "contains", "value": "/docs/prompting-guide.md"},
        {"criterion_id": "AC5", "target": "result", "path": "/stdout", "op": "contains", "value": "/RUNBOOK.md"},
