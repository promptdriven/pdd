        {"criterion_id": "AC1", "target": "result", "path": "/stdout", "op": "contains", "value": "/docs/prompting-guide.md"},
        {"criterion_id": "AC1", "target": "result", "path": "/stdout", "op": "contains", "value": "/RUNBOOK.md"},
        {"criterion_id": "AC1", "target": "result", "path": "/stderr", "op": "equals", "value": ""},
        {"criterion_id": "AC1", "target": "result", "path": "/exit_code", "op": "equals", "value": 0},
        {"criterion_id": "AC7", "target": "result", "path": "/stdout", "op": "not_contains", "value": "pdd check"},
        {"criterion_id": "AC7", "target": "result", "path": "/stdout", "op": "not_contains", "value": "pdd try"},
        {"criterion_id": "AC7", "target": "result", "path": "/stdout", "op": "not_contains", "value": "workflow start"},
        {"criterion_id": "AC7", "target": "result", "path": "/exit_code", "op": "equals", "value": 0}
