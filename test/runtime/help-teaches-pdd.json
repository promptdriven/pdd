{
  "schema_version": "prompt-runtime.program-scenario.v1",
  "story_path": "user_stories/help-teaches-pdd.md",
  "criteria": [
    {"id": "AC1", "text": "`pdd`, `pdd --help`, `pdd -h` and `pdd help` each name `pdd help prompting` and the full paths of the installed Prompting guide (`docs/prompting-guide.md`) and RUNBOOK (`RUNBOOK.md`), print nothing to stderr and exit with code 0."},
    {"id": "AC2", "text": "`pdd help prompting` shows how to write a prompt with `## Dependencies`, a Story with numbered acceptance criteria, and its test; it exits with code 0 and no stderr."},
    {"id": "AC3", "text": "`pdd --help` opens with usage and starting examples, groups commands by purpose, and points to focused help rather than listing options like `--share` or approval examples."},
    {"id": "AC4", "text": "`pdd help prompting` names `pdd test`, `pdd lint` and `pdd approve` and the full installed guide and RUNBOOK paths."},
    {"id": "AC5", "text": "`pdd help autopilot` lists `pdd autopilot start`, and `pdd autopilot start --help` explains the `--share` range and default. `pdd help approve` shows the quoted `--said -` heredoc. All three exit with code 0 and no stderr."},
    {"id": "AC6", "text": "`pdd prompting` is still an unknown command: it prints nothing to stdout, prints one line to stderr that says \"Unknown command\" and names `prompting`, and exits with code 2."}
  ],
  "initial_world": {"unexpected_launcher_calls": []},
  "simulation": {
    "autopilotLauncher.runAutopilotLauncher": {"action":"port.write","world_pointer":"/unexpected_launcher_calls","result_template":{"exitCode":255,"message":"Unexpected Autopilot dispatch in a non-Autopilot scenario"}}
  },
  "context": [],
  "steps": [
