{
  "schema_version": "prompt-runtime.program-scenario.v1",
  "story_path": "user_stories/help-teaches-pdd.md",
  "criteria": [
    {"id": "ac-sha256-0760be3dc7a0e129a92c651aa191dcc765ad7ea05332f144", "text": "`pdd`, `pdd --help`, `pdd -h` and `pdd help` each name `pdd help prompting` and the full paths of the installed Prompting guide (`docs/prompting-guide.md`) and RUNBOOK (`RUNBOOK.md`), print nothing to stderr and exit with code 0."},
    {"id": "ac-sha256-54812b0d9437309763dd6461c87f0e7ab80901ba18f1f6c6", "text": "`pdd help prompting` shows how to write a prompt file, `prompts/NAME.prompt.md`, with its `## Dependencies` section, prints nothing to stderr and exits with code 0."},
    {"id": "ac-sha256-e9b37c47d4d6c9191ed635990236b557f60701164a637f3f", "text": "`pdd help prompting` shows how to write a Story file, `user_stories/STORY.md`, with its numbered acceptance criteria, and the Story's test file, `tests/STORY.json`, and exits with code 0."},
    {"id": "ac-sha256-3c5437ba8f4f05edc98f389c1f029ddd6fb1615dc9048cf8", "text": "`pdd help prompting` names the commands `pdd test`, `pdd lint` and `pdd approve`, and exits with code 0."},
    {"id": "ac-sha256-7128db3416b7a3d8e2cc7c8b44ab6f5bfec27f8ad0482b3a", "text": "`pdd help prompting` names the full paths of the installed `docs/prompting-guide.md` and `RUNBOOK.md`, and exits with code 0."},
    {"id": "ac-sha256-a0a907c3c6785926d618701a7ca31ee340a2e90545559c6c", "text": "`pdd prompting` is still an unknown command: it prints nothing to stdout, prints one line to stderr that says \"Unknown command\" and names `prompting`, and exits with code 2."},
    {"id": "ac-sha256-f05cfdd02e9fc2fe43859f11f0b0978c391cd5255ff1c454", "text": "`pdd --help` and `pdd help prompting` never name a removed command (\"pdd check\", \"pdd try\" or \"workflow start\") and exit with code 0."}
  ],
  "initial_world": {"unexpected_launcher_calls": []},
