{
  "schema_version": "prompt-runtime.program-scenario.v1",
  "story_path": "user_stories/shared-records.md",
  "criteria": [
    {
      "id": "AC1",
      "text": "A record heading with spaces and its heading fragment expand to the same schema."
    },
    {
      "id": "AC2",
      "text": "A JSON Pointer can select escaped names and array index 0, including nested shared records."
    },
    {
      "id": "AC3",
      "text": "A missing record is refused instead of producing a partial schema."
    },
    {
      "id": "AC4",
      "text": "A cycle of shared records is refused."
    },
    {
      "id": "AC5",
      "text": "An ambiguous heading is refused instead of choosing a record."
    },
    {
      "id": "AC6",
      "text": "Literal defaults retain their values during expansion; source with no applicable reference keeps its exact bytes."
    },
    {
      "id": "AC7",
      "text": "A local title and description survive expansion of a shared schema."
    },
    {
      "id": "AC8",
      "text": "A local constraint beside a shared reference is refused instead of silently overriding it."
    },
    {
      "id": "AC9",
      "text": "Expansion keeps the surrounding JSON layout and key order, including reasoning before answer."
    },
    {
      "id": "AC10",
      "text": "The record title C# keeps its literal hash, with or without a spaced closing hash marker."
    }
  ],
