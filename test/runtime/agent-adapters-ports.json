{
  "schema_version": "prompt-runtime.program-scenario.v1",
  "story_path": "user_stories/agent-adapters-ports.md",
  "criteria": [
    {
      "id": "AC1",
      "text": "parseAgentAuthStatus returns ready, signed_out, or unavailable directly from the supplied status observation. An unknown agent or malformed result returns unavailable."
    },
    {
      "id": "AC2",
      "text": "discoverAgents loads default definitions through the shared agent-config owner when none are supplied, then checks help and authentication status. It reports not_installed only when the process observation proves the executable is missing."
    },
    {
      "id": "AC3",
      "text": "askAgent validates a fill against the selected entry's complete input schema. It preserves run=true only when supportsRun, supportsApply, apply=true, and a valid fill are present. Other optional fields survive only when they pass their native rules."
    },
    {
      "id": "AC4",
      "text": "An unknown agent returns a structured failure with fill=null and no subprocess call. runAgentProcess returns {code, stdout, stderr} on success."
    }
  ],
