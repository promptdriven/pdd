{
  "schema_version": "prompt-runtime.program-scenario.v1",
  "story_path": "user_stories/workflow-codex-thread-budget.md",
  "criteria": [
    {
      "id": "AC1",
      "text": "I can start a bundled Codex workflow with 5 total thread slots for bug/feature story and prompt-pr or small-change plan, and 6 for bug/feature code or small-change build, when no explicit personal value exists."
    },
    {
      "id": "AC2",
      "text": "My explicit modern Codex thread setting takes precedence over either agents alias, and either alias counts helpers plus one main thread; my value is preserved even below the workflow request or above 8."
    },
    {
      "id": "AC3",
      "text": "I can opt a custom area into an integer thread budget from 4 through 8; invalid supplied budgets are rejected, while an area without the field keeps its existing launch behavior without reading configuration."
    },
    {
      "id": "AC4",
      "text": "If configuration or its active layers cannot be established safely, my chat starts without a thread override and its record and status visibly explain the unknown setting."
    },
    {
      "id": "AC5",
      "text": "First starts, stopped-session resumes and requested fresh sessions use the saved account configuration, preserve newly changed explicit personal settings, and retain the selected total and source in chat/run records; status reports saved launch facts without rereading configuration."
    },
    {
      "id": "AC6",
      "text": "Claude chats and legacy saved areas keep their existing behavior; thread policy changes neither approval authority nor checker independence, and an exhausted checker still reports \"Not checked:\" honestly."
    }
  ],
