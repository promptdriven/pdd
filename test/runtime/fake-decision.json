{
  "entry_path": "examples/fakes/decision.prompt.md",
  "initial_world": {
    "requests": []
  },
  "simulation": {
    "service.lookup": {
      "action": "port.write",
      "world_pointer": "/requests",
      "result_template": {
        "available": true
      }
    }
  },
  "steps": [
    {
      "id": "pure-unavailable",
      "op": "decideReply",
      "input": {
        "reply": {
          "available": false
        }
      },
      "checks": {
        "1": [
          ["result", "/label", "=", "Unavailable"],
          ["world", "/requests", "=", []]
        ]
      }
    },
    {
      "id": "effect-available",
      "op": "doLookup",
      "input": {
        "id": "book-7"
      },
      "checks": {
        "1": [
          ["result", "/label", "=", "Available"],
          ["world", "/requests", "=", [{"id": "book-7"}]]
        ]
      }
    }
  ]
}
