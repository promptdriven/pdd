  "criteria": [
    {
      "id": "AC1",
      "text": "When I accept setup, each registration uses the running Node executable and the selected package's `bin/pdd.mjs` entry with `mcp` arguments, writes the previewed config, and reports success."
    },
    {
      "id": "AC2",
      "text": "When `prompt.confirm` returns any answer other than `y`, `setupAgentMcp` writes no files and returns `{exitCode: 0}`."
    },
    {
      "id": "AC3",
      "text": "When a candidate configuration file is a symbolic link or malformed, `setupAgentMcp` emits a `pdd setup:` diagnostic to `output.stderr`, asks no confirmation question, writes nothing, and returns `{exitCode: 1}`."
    }
  ],
