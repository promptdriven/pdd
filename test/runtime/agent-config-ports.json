{
  "schema_version": "prompt-runtime.program-scenario.v1",
  "story_path": "user_stories/agent-config-ports.md",
  "criteria": [
    {
      "id": "AC1",
      "text": "When `$HOME/.config/pdd/agents.json` is absent, `loadAgentDefinitions` returns the built-in `codex`, `claude`, and `gemini` launchers without reading any repository `.pdd/agents.json` file."
    },
    {
      "id": "AC2",
      "text": "When `$HOME/.config/pdd/agents.json` is valid, `loadAgentDefinitions` expands leading `~/` paths against `HOME`, assigns `custom-` plus the first 24 SHA-256 hex characters of the exact name, registers secret-named override values through `secrets.remember`, and appends built-in defaults unless `include_defaults` is false."
    },
    {
      "id": "AC3",
      "text": "`loadAgentDefinitions` raises `invalid-agents-config` without reading contents or falling back when `$HOME/.config/pdd/agents.json` is a symbolic link or exceeds 65536 bytes."
    },
    {
      "id": "AC4",
      "text": "`loadAgentDefinitions` raises `invalid-agents-config` without fallback when `$HOME/.config/pdd/agents.json` contains an unknown agent kind or a name that collides with an enabled default launcher."
    }
  ],
  "initial_world": {
    "files": {
      "/repo/.pdd/agents.json": {
        "content": "{\"agents\":[{\"name\":\"Repo Evil\",\"kind\":\"codex\",\"command\":\"/tmp/evil\"}]}",
        "is_symlink": false
      },
      "/home/dev/.config/pdd/agents.json": {
        "content": "{\"include_defaults\":true,\"agents\":[{\"name\":\"Work Codex\",\"kind\":\"codex\",\"command\":\"~/bin/codex-work\",\"env\":{\"OPENAI_API_KEY\":\"sk-secret-token-123\",\"CODEX_HOME\":\"~/.codex-work\"}}]}",
        "is_symlink": false
      },
      "/home/symlink/.config/pdd/agents.json": {
        "content": "{\"agents\":[]}",
        "is_symlink": true
      },
      "/home/invalid/.config/pdd/agents.json": {
        "content": "{\"agents\":[{\"name\":\"Codex\",\"kind\":\"codex\",\"command\":\"codex\"}]}",
        "is_symlink": false
      }
    },
    "secrets": []
  },
  "simulation": {
    "files.stat": {
      "action": "blob.stat",
      "world_pointer": "/files",
      "path_argument_pointer": "/path",
      "content_argument_pointer": null,
      "result_template": {
