{
  "schema_version": "prompt-runtime.program-scenario.v1",
  "story_path": "user_stories/project-setup-ports.md",
  "criteria": [
    {
      "id": "AC1",
      "text": "`setupProject` updates the `pdd:start` to `pdd:end` marker block in `CLAUDE.md` under `cwd` when present (preserving surrounding text and dropping `RUNBOOK.md` lines when `RUNBOOK.md` under `packageRoot` does not exist), and creates `AGENTS.md` under `cwd` when neither file exists."
    },
    {
      "id": "AC2",
      "text": "`setupProject` fails with `invalid_pdd_markers` without writing when the target file has reversed or duplicate marker lines."
    },
    {
      "id": "AC3",
      "text": "`ignorePddFolder` appends `.pdd/` to `.gitignore` under `root` when no `.pdd` rule is present, returns `changed: false, negated: true` without writing when a negation rule such as `!.pdd/config.json` is present, and fails with `invalid_gitignore_target` when `.gitignore` under `root` is a symlink."
    }
  ],
  "initial_world": {
    "files": {
      "/pkg/skills/pdd-setup/SKILL.md": {
        "content": "# PDD Setup\n\n```markdown\n<!-- pdd:start -->\nUse PDD skills for changes.\nFollow RUNBOOK.md for merges.\n<!-- pdd:end -->\n```\n",
        "is_symlink": false
      },
      "/repo-claude/CLAUDE.md": {
        "content": "# Project rules\n\n<!-- pdd:start -->\nOld block\n<!-- pdd:end -->\n\nKeep tests green.\n",
        "is_symlink": false
      },
      "/repo-bad/AGENTS.md": {
        "content": "<!-- pdd:end -->\n<!-- pdd:start -->\n",
        "is_symlink": false
      },
      "/repo-ignore/.gitignore": {
        "content": "node_modules/\n",
        "is_symlink": false
      },
      "/repo-negated/.gitignore": {
        "content": "node_modules/\n!.pdd/config.json\n",
        "is_symlink": false
      },
      "/repo-symlink/.gitignore": {
        "content": "node_modules/\n",
        "is_symlink": true
      }
    }
  },
