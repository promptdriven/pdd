            "argv": [
              "lint",
              "project-files-ports"
            ]
          },
          "result": {
            "exitCode": 0
          }
        }
      ],
      "result_template": null,
      "result_value_pointer": ""
    },
    "output.stderr": {
      "action": "port.write",
      "world_pointer": "/stderr",
      "result_template": {
        "ok": true
      }
    }
  },
  "context": [],
