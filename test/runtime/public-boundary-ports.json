{
  "schema_version": "prompt-runtime.program-scenario.v1",
  "story_path": "user_stories/public-boundary-ports.md",
  "criteria": [
    {
      "id": "AC1",
      "text": "`dispatchBoundaryCommand` routes local commands (`workflow view`, `metrics`, `setup`, `--help`) through `local.dispatch` with `usesInterpreter: false` and zero `interpreter.call` invocations, and routes `test`, `lint`, `simulate`, and `mcp` through `interpreter.call` with `usesInterpreter: true`."
    },
    {
      "id": "AC2",
      "text": "`dispatchBoundaryCommand` refuses excluded or removed commands (`session`, `workflow feature`, `check`, `try`) with `{exitCode: 2, route: \"refused\", usesInterpreter: false}` and a diagnostic on `output.stderr` before calling `local.dispatch` or `interpreter.call`, and raises `empty-command-argv` when `argv` is empty."
    },
    {
      "id": "AC3",
      "text": "`validateBoundaryText` accepts `\"the PDD interpreter\"`, `pdd test`, `pdd lint`, `pdd simulate`, and `pdd workflow run` on `\"person\"` lines as well as `\"runtime\"` and `\"check\"`/`\"try\"` tokens on `\"machine\"` or `\"server\"` lines, and raises `forbidden-boundary-word` when a `\"person\"` line says `\"PDD runtime\"`, `\"the runtime\"`, `\"pdd check\"`, or `\"pdd try\"`."
    }
  ],
  "initial_world": {
    "calls": {
      "localDispatch": 0,
      "interpreterCall": 0
    },
    "stderr": []
  },
  "simulation": {
    "local.dispatch": {
      "action": "fixture.lookup",
      "world_pointer": "/calls/localDispatch",
      "cases": [
        {
          "call_index": 1,
          "args": {
            "route": "metrics",
            "argv": [
              "metrics",
              "--json"
            ]
          },
          "result": {
            "exitCode": 0
          }
        }
      ],
      "result_template": null,
      "result_value_pointer": ""
    },
    "interpreter.call": {
