{
  "schema_version": "prompt-runtime.program-scenario.v1",
  "story_path": "user_stories/release-notice.md",
  "criteria": [
    {
      "id": "AC1",
      "text": "When I run an older pdd after a release, I see one stderr line naming the new version, my installed version and the exact GitHub update command; stdout and the command exit status stay intact."
    },
    {
      "id": "AC2",
      "text": "Equal or older releases, malformed release data and an unavailable release service do not produce a reminder or prevent my command."
    },
    {
      "id": "AC3",
      "text": "CI and internal PATH version probes skip the release lookup and reminder."
    },
    {
      "id": "AC4",
      "text": "A stable release replaces an installed prerelease with the same version numbers; version numbers compare numerically and build metadata does not make an equal release newer."
    },
    {
      "id": "AC5",
      "text": "pdd never installs an update automatically, including during a workflow or in CI; a release lookup has a one-second deadline and a 65536-byte response limit."
    }
  ],
  "initial_world": {
    "reads": []
  },
  "simulation": {
    "releases.latest": {
      "action": "port.write",
      "world_pointer": "/reads",
      "result_template": {
        "tag": "alpha-v0.1.29"
      }
    }
  },
  "context": [],
  "steps": [
