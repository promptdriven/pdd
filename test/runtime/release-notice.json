      "step_id": "new-release",
      "entry_path": "prompts/cli/release-notice.prompt.md",
      "operation": "releaseNotice",
      "input": {
        "version": "0.1.28",
        "ci": false,
        "probe": false
      },
      "checks": [
        {
          "criterion_id": "AC1",
          "target": "result",
          "path": "/message",
          "op": "equals",
          "value": "pdd 0.1.29 is available (installed 0.1.28). Update: npm install -g github:promptdriven/pdd#alpha-v0.1.29"
        },
        {
          "criterion_id": "AC1",
          "target": "calls",
          "path": "/resources/release-notice-releases-latest",
          "op": "equals",
          "value": 1
        }
      ],
      "model": "gpt-6.1-sol"
