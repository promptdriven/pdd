{
  "schema_version": "prompt-runtime.program-scenario.v1",
  "story_path": "user_stories/setup-readiness.md",
  "criteria": [
    {
      "id": "AC1",
      "text": "`pdd setup --check --json` prints `{\"ready\":true}` and exits 0 when the current project has its current PDD block and its Git root ignores `.pdd/` or has a respected negation that setup preserves."
    },
    {
      "id": "AC2",
      "text": "`pdd setup --check --json` prints `{\"ready\":false}` and exits 0 when the block or ignore handling still needs setup; checking changes no file and starts no setup, authentication, agent status or network work."
    },
    {
      "id": "AC3",
      "text": "`pdd setup --check` prints `Ready` or `Not ready` for the same conditions; `--json` without `--check` and `--check` combined with `--yes`, `--no-pair` or `--pair-code` exit 2 before setup effects."
    }
  ],
