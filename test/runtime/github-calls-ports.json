  "criteria": [
    {
      "id": "AC1",
      "text": "`githubCall`, `githubPurpose`, `githubRepository`, `githubReply`, `githubEntry`, `githubStateRoot` and `githubFullLastPage` classify normal inputs and return their fallback values for non-matching inputs."
    },
    {
      "id": "AC2",
      "text": "`githubLedger` (`record`, `read`, `compact`) and `githubMachineEntries` record, read and compact repository ledger entries and skip invalid lines or missing directories."
    },
    {
      "id": "AC3",
      "text": "`countGithubCalls` and `nativeGithubCounter` forward successful calls and record ledger and cost entries, and raise `exec-failed` when the underlying command exits nonzero."
    },
    {
      "id": "AC4",
      "text": "`githubUsage`, `githubBudgetSettings`, `githubBudget` and `githubStatusLine` compute hourly counts, budget states (`normal`, `low`, `reserve`) and status lines, falling back to defaults for invalid settings."
    },
    {
      "id": "AC5",
      "text": "`githubEtagCache` (`get`, `set`, `save`) and `githubFloorGuard` (`observe`, `blocked`) manage cached ETags and rate-limit floor blocking across normal and missing/unblocked cases."
    }
  ],
