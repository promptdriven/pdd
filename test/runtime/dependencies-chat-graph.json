  "schema_version": "prompt-runtime.program-scenario.v1",
  "story_path": "user_stories/dependencies-chat-graph.md",
  "criteria": [
    {
      "id": "AC1",
      "text": "A cached graph is returned before the GitHub refresh finishes; reading it schedules only a read refresh and makes no AI or GitHub mutation call."
    },
    {
      "id": "AC2",
      "text": "The text summary and selected issue explanation use the same saved graph and preserve current, stale, offline and unknown facts."
    },
    {
      "id": "AC3",
      "text": "A headless open request gives the exact laptop command for the selected repository and issue, and invokes no VM opener."
    },
    {
      "id": "AC4",
      "text": "A local open request invokes the bundled viewer. No cache gives an honest empty state, and an offline or partial refresh preserves the last successful graph and sync time."
    }
  ],
