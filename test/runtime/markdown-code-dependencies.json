  {"step_id":"first-normalized-definition","entry_path":"prompts/cli/runtime-markdown.prompt.md","operation":"markdownDefinitions","input":{"text":"[ Full ]: <full.svg>\n[full]: ignored.svg\n[collapsed]: collapsed.svg\n[shortCUT]: shortcut.svg\n"},"checks":[{"criterion_id":"AC3","target":"result","path":"/definitions","op":"equals","value":[{"label":"full","destination":"full.svg"},{"label":"collapsed","destination":"collapsed.svg"},{"label":"shortcut","destination":"shortcut.svg"}]}]},
  {"step_id":"reference-image-parity","entry_path":"prompts/cli/runtime-markdown.prompt.md","operation":"markdownLinks","input":{"text":"![image][full]\n\\![image][full]\n\\\\![image][full]\n!\\[image][unresolved]\n![collapsed][]\n\\![collapsed][]\n!\\[collapsed][]\n![shortcut]\n\\![shortcut]\n!\\[shortcut]\n\\\\[shortcut]\n","definitions":{"$step_result":{"step_id":"first-normalized-definition","path":"/definitions"}},"imagesOnly":true},"checks":[{"criterion_id":"AC2","target":"result","path":"/destinations","op":"equals","value":["full.svg","full.svg","collapsed.svg","shortcut.svg"]}]},
