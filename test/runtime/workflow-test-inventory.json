{
  "schema_version": "prompt-runtime.program-scenario.v1",
  "story_path": "user_stories/workflow-test-inventory.md",
  "criteria": [
    {
      "id": "AC1",
      "text": "For three named cases reduced to two by removing \"gone\" and \"also gone\" and adding \"new\", the report shows 3 → 2 tests and names both removed cases \"gone\" and \"also gone\"."
    },
    {
      "id": "AC2",
      "text": "A renamed test file keeps matching case names; a deleted test file names its removed case, and an added file shows 0 → 1 tests, preserving unusual paths."
    },
    {
      "id": "AC3",
      "text": "Comparison requests retain the exact saved base and committed head; unavailable data is shown as unavailable rather than none."
    }
  ],
  "initial_world": {
    "requests": []
  },
