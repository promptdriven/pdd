            "after": "test('keep', () => {});\ntest('new', () => {});\n"
          }
        ]
      },
      "checks": [
        {
          "criterion_id": "AC1",
          "target": "result",
          "path": "/available",
          "op": "equals",
          "value": true
        },
        {
          "criterion_id": "AC1",
          "target": "result",
          "path": "/text",
          "op": "equals",
          "value": "Tests vs base: \"test/a.test.mjs\" 3 → 2 tests. Removed: 2 (`\"gone\"`, `\"also gone\"`).\nChanged assertions in kept tests: none.\nNew skips: none.\nStatic inventory only; tests were not run.\n"
        },
        {
