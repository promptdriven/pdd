{
  "schema_version": "prompt-runtime.program-scenario.v1",
  "story_path": "user_stories/approval-evidence-ports.md",
  "criteria": [
    {
      "id": "AC1",
      "text": "`findNativeSessions` skips files whose `mtimeMs` is older than `stage.startedAt` without reading their contents, excludes subagent rollouts, and returns matching sessions `[{id, startedAt}]`."
    },
    {
      "id": "AC2",
      "text": "`findNativeSessions` raises `session_unreadable` when session discovery encounters an unreadable directory or file rather than returning an empty list."
    },
    {
      "id": "AC3",
      "text": "`readApprovalEvidence` excludes generated `environment_context` wrappers, `[Request interrupted` lines, and `ignorePrefixes` matches, returning the latest eligible human message after `gateAskedAt` or `{ok: false, code: \"user_message_missing\"}` when none remain."
    },
    {
      "id": "AC4",
      "text": "`readApprovalEvidence` raises `clock_unavailable` without reading session directories when `clock.now` returns a non-positive observation timestamp."
    }
  ],
