{
  "schema_version": "prompt-runtime.program-scenario.v1",
  "story_path": "user_stories/secret-redaction-ports.md",
  "criteria": [
    {
      "id": "AC1",
      "text": "Remembering secrets stores deduplicated values and combines them with secret-named environment entries in `knownSecretValues`."
    },
    {
      "id": "AC2",
      "text": "Streaming redaction holds back undecided secret prefixes across chunk boundaries, emits `[redacted]` once the secret completes, and flushes remaining safe text on `end`."
    },
    {
      "id": "AC3",
      "text": "Scalar `redactSecrets` replaces remembered values and token patterns with `[redacted]`."
    },
    {
      "id": "AC4",
      "text": "Invalid inputs or writing to a closed stream fail with `empty-secret-values`, `invalid-secret-env`, `invalid-stream-secrets`, `stream-closed` and `invalid-redact-target`."
    }
  ],
  "initial_world": {
    "memory": [],
    "streams": [],
    "emissions": []
  },
  "simulation": {
    "memory.load": {
      "action": "collection.get",
      "world_pointer": "/memory",
      "key_argument_pointer": "/id",
      "value_argument_pointer": null,
      "item_key_pointer": "/id",
      "item_value_pointer": "/state",
      "result_template": {
        "state": null
      },
      "result_value_pointer": "/state"
    },
    "memory.save": {
      "action": "collection.merge",
      "world_pointer": "/memory",
      "key_argument_pointer": "/id",
      "value_argument_pointer": "/state",
      "item_key_pointer": "/id",
      "item_value_pointer": "/state",
      "result_template": {
        "state": null
      },
      "result_value_pointer": "/state"
    },
    "streams.store": {
      "action": "collection.merge",
      "world_pointer": "/streams",
      "key_argument_pointer": "/handle",
      "value_argument_pointer": "/state",
      "item_key_pointer": "/handle",
      "item_value_pointer": "/state",
      "result_template": {
        "state": null
      },
      "result_value_pointer": "/state"
    },
    "streams.load": {
      "action": "collection.get",
      "world_pointer": "/streams",
      "key_argument_pointer": "/handle",
      "value_argument_pointer": null,
      "item_key_pointer": "/handle",
      "item_value_pointer": "/state",
      "result_template": {
        "state": null
      },
      "result_value_pointer": "/state"
    },
    "output.emit": {
      "action": "port.write",
      "world_pointer": "/emissions",
      "result_template": {}
    }
  },
  "context": [],
