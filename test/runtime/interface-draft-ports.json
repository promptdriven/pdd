  "criteria": [
    {
      "id": "AC1",
      "text": "`missingInterfaces`, `interfaceFindings`, `cliInterfaceFindings` and `runtimeCoverage` report missing declarations, schema findings and checkable counts across workspace prompts."
    },
    {
      "id": "AC2",
      "text": "`contractCoverage` and `coverageView` map prose sentences to interface pointers and format coverage lines."
    },
    {
      "id": "AC3",
      "text": "`runInterfaceDraft` installs a supplied contract into an undeclared prompt and `runAutomaticApproval` approves a clean draft after passing native tests and prompt checks."
    },
    {
      "id": "AC4",
      "text": "Unavailable roots, missing prompts, invalid coverage reports, empty draft working directories and refused automatic approvals fail with their declared error codes."
    }
  ],
