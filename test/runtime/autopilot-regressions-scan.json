    {
      "id": "ac-sha256-2ce187b863e021dd10e565f4b3c2bc732dc265a902d55663",
      "text": "Scanning core history and supplied candidates includes pull requests merged after auto, observe, and stopped runs, and skips unmerged observe or stopped pull requests with no error."
    },
    {
      "id": "ac-sha256-089a04f78bdaba8e56054b50cf1dd6930d144079ca369b7c",
      "text": "A later default-branch revert commit naming the exact merge commit hash marks that pull request as a proven revert regression."
    },
    {
      "id": "ac-sha256-7f11a2ba3dca4b0a19371d526671c9e16ff6475c02a2ed75",
      "text": "A later follow-up issue labeled regression or explicitly blaming the merged pull request marks it as a proven regression reference, while an unlabeled mention stays suspect."
    },
    {
      "id": "ac-sha256-4d7ef376f9dd0463713acdcb1669fc4c7313fb8976a76c7a",
      "text": "A human reopen event on the merged issue after merge is recorded as a reopened signal, while a machine-marked reopen is ignored."
    }
  ],
