{
  "schema_version": "prompt-runtime.program-scenario.v1",
  "story_path": "user_stories/dependencies-interactive-graph.md",
  "criteria": [
    {
      "id": "AC1",
      "text": "The graph shows search, status filters, the graph and selected issue reasons, with the last successful sync and refreshing or offline state."
    },
    {
      "id": "AC2",
      "text": "Search and filters retain matching nodes and their prerequisite context without changing readiness. Selecting issue 42 shows its blocker reason and evidence."
    },
    {
      "id": "AC3",
      "text": "A running filter uses actual execution state. Unknown work remains labeled unknown, and no matching issue gives an empty result rather than invented readiness."
    },
    {
      "id": "AC4",
      "text": "An offline update keeps the selected issue and its reasons. The layout stacks details below the graph when the panes cannot fit side by side."
    },
    {
      "id": "AC5",
      "text": "A saved deployment question shows its exact text, owning issue and source after restart. A trusted replacement updates those facts. With no cache the viewer shows \"No saved graph\" and no ready work."
    }
  ],
