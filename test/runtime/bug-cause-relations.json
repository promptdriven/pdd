  "criteria": [
    {
      "id": "AC1",
      "text": "A reproduced bug records the file, function, flaw, class and explicit relations with exact evidence quotes; no discovered relations is recorded as an empty list."
    },
    {
      "id": "AC2",
      "text": "A quote absent from the named issue or code is refused before any GitHub link is written."
    },
    {
      "id": "AC3",
      "text": "Only explicitly selected relations write links: needs can block the current issue, same class can put it under an existing Class parent, and duplicate can mark the duplicate; shared cause alone creates no dependency."
    }
  ],
