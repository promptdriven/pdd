  "criteria": [
    {
      "id": "AC1",
      "text": "`githubOriginRepository` returns `promptdriven/pdd` for an ordinary GitHub SSH origin and `null` for a non-GitHub origin."
    },
    {
      "id": "AC2",
      "text": "`lookupRepositoryParent` returns `ready` with the primary checkout root when the common directory and origin match, and `recovery_required` when they do not."
    },
    {
      "id": "AC3",
      "text": "`allocateIssueWorktree` returns `ready` with the verified assignment for a valid unclaimed issue, and `conflict` when the requested repository disagrees with the checkout origin."
    },
    {
      "id": "AC4",
      "text": "`lookupIssueWorktree` returns `ready` with the saved assignment when the worktree registration matches, and `recovery_required` when the run record is missing."
    },
    {
      "id": "AC5",
      "text": "`releaseIssueClaim` returns `released` when the claim belongs to the cancelled run, and `conflict` when the claim belongs to another run."
    }
  ],
