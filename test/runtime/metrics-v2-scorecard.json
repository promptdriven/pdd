{
  "schema_version": "prompt-runtime.program-scenario.v1",
  "story_path": "user_stories/metrics-v2-scorecard.md",
  "criteria": [
    {
      "id": "ac-sha256-d2d31a99e3023205859592a936914fce8855422347de8f97",
      "text": "A unified report names enabled repositories explicitly in the header, excludes turned-off repositories from unified counts and scope labels, and shows the live open issue count."
    },
    {
      "id": "ac-sha256-43e666e225afe7a092303ba40ad14937f0df3fb27148fccf",
      "text": "Each window computes its accumulated pool as the union of currently open issues, issues closed in the window, and issues taken in the window, so Pool is at least Taken, Taken is at least PRs, and PRs is at least Merged, with distinct pools for Last 24h and Week (Mon-Sun)."
    },
    {
      "id": "ac-sha256-94a1539f930d42948b3c3375ca281efcad962c3e3362e3ba",
      "text": "Pull requests merged on GitHub after observe or stopped runs count as Merged, while unmerged pull requests stay under Unmerged PRs alongside the Before PR breakdown so Taken equals Before PR plus PRs and PRs equals Merged plus Unmerged PRs."
    },
    {
      "id": "ac-sha256-e6b122db8f73dff0b4cc0b5692b858a21aa909b5594bec89",
      "text": "Funnel and Gates separates PR Gates over all pull requests (including E2E when recorded) from Prompt Checks over prompt-changing pull requests, and reports auto-detected regressions both in the overview table and in the regressions breakdown."
    },
    {
      "id": "ac-sha256-8f620c6c3fbde687e4db272a00d0c5a4bb750701d5c9562e",
      "text": "The overview includes a monthly Target row below Week (Mon-Sun) defaulting to >=90% conversion and 0.0% regressions, honors custom configured targets, and shows question marks for open and pool counts when live GitHub counts are unavailable."
    },
    {
      "id": "ac-sha256-2c76f714087f67c6ef1f01c69bb1c6ef62249799af9ca15b",
      "text": "Filtering explicitly by a turned-off repository still renders that repository's scorecard while keeping pre-pause runs and excluding runs recorded after it was paused."
    }
  ],
