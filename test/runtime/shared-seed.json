{
  "schema_version": "prompt-runtime.program-scenario.v1",
  "story_path": "user_stories/shared-seed.md",
  "criteria": [
    {
      "id": "AC1",
      "text": "A shared world can replace an array value, add an object key and preserve 0, false and null."
    },
    {
      "id": "AC2",
      "text": "Starting another scenario from the same seed leaves the shared world unchanged."
    },
    {
      "id": "AC3",
      "text": "Overlapping overrides apply in written order, including replacement of the whole world."
    },
    {
      "id": "AC4",
      "text": "An override with a missing parent or array index is refused."
    },
    {
      "id": "AC5",
      "text": "Literal step inputs and expected values containing reference-like keys stay literal."
    }
  ],
  "initial_world": {
    "files": {
      "contracts/seed-world.json": {
        "content": "{\"flags\":{\"a/b~c\":1},\"keep\":null,\"orders\":[{\"done\":true,\"total\":9}]}",
        "is_symlink": false
      }
    }
  },
