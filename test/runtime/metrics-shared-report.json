  "story_path": "user_stories/metrics-shared-report.md",
  "criteria": [
    {
      "id": "AC1",
      "text": "A group containing issues 1 and 2 still contains two issues when issue 1 has two attempts and two pull requests."
    },
    {
      "id": "AC2",
      "text": "An attempted launch without a confirmed start does not count as a start."
    },
    {
      "id": "AC3",
      "text": "A checker pass for an old candidate does not validate a changed candidate."
    },
    {
      "id": "AC4",
      "text": "A later delivered fix remains attributed to the original group, and an administrative reopen is separate from a human report that the fix is still broken."
    },
    {
      "id": "AC5",
      "text": "Importing the same event twice does not add a second issue or event, and an absent machine is shown as a coverage gap."
    }
  ],
