{
  "schema_version": "prompt-runtime.program-scenario.v1",
  "story_path": "user_stories/metrics-gap-ports.md",
  "criteria": [
    {
      "id": "AC1",
      "text": "`recordCaptureGap` normalizes the repository slug to lowercase, formats the observation timestamp as ISO-8601 UTC, allocates a gap UUID, and writes only the `pdd.metrics.event.v1` incomplete-coverage record to `pdd/metrics-gaps/{id}.json` under `commonDir`."
    },
    {
      "id": "AC2",
      "text": "`recordCaptureGap` raises `invalid-gap-observation` without touching storage or allocating a UUID when the repository slug, issue number, or timestamp is invalid."
    },
    {
      "id": "AC3",
      "text": "`recordCaptureGap` raises `storage-unavailable` without writing a gap file when `commonDir` is missing or is a symbolic link."
    }
  ],
