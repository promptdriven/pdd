{
  "schema_version": "prompt-runtime.program-scenario.v1",
  "story_path": "user_stories/cost-ledger-ports.md",
  "criteria": [
    {
      "id": "AC1",
      "text": "`recordCostGithub` appends a timestamped JSONL entry to `github-cost.jsonl` in the run directory via `files.read` and `files.write`, and throws `Error` when `runDir` or `entry.at` is invalid."
    },
    {
      "id": "AC2",
      "text": "`captureClosedCi` reserves `cost-ci-N.json` via `files.stat` and `files.write`, queries `gh api` via `exec.execFile` for closed or merged PR workflow runs, writes `{attempted: true, minutes, complete}`, and throws `Error` when the run input is invalid."
    },
    {
      "id": "AC3",
      "text": "`captureCosts` reads Claude or Codex session transcripts, audit directories via `fs.readdir`, `github-cost.jsonl`, and `cost-ci-N.json`, hashes account and session identities via `compute.hash_utf8`, computes person waiting minutes and outcome, and throws `Error` when `run` is invalid."
    },
    {
      "id": "AC4",
      "text": "`applyCostMeasurement` records suite minutes, active person minutes, and explicit outcomes once per measurement id, ignores identical retries, and throws `Error` on invalid input or measurement id conflicts."
    },
    {
      "id": "AC5",
      "text": "`costReport` and `costStatusLines` aggregate 1-day and 7-day totals, coverage, and merged-issue P50/P90 percentiles and format the status summary text, throwing `Error` on invalid inputs."
    }
  ],
