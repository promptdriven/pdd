{
  "entry_path": "examples/fakes/files.prompt.md",
  "initial_world": {
    "files": {
      "/notes/hello.txt": {
        "content": "Hello\n",
        "is_symlink": false
      }
    }
  },
  "simulation": {
    "files.read": {
      "action": "blob.read",
      "world_pointer": "/files",
      "path_argument_pointer": "/path",
      "content_argument_pointer": null,
      "result_template": {
        "content": ""
      },
      "result_value_pointer": "/content"
    }
  },
  "steps": [
    {
      "id": "read-note",
      "op": "readNote",
      "input": {
        "path": "/notes/hello.txt"
      },
      "checks": {
        "1": [
          ["result", "/content", "=", "Hello\n"]
        ]
      }
    }
  ]
}
