{
  "schema_version": "prompt-runtime.program-scenario.v1",
  "story_path": "user_stories/bounded-workspace-policy.md",
  "criteria": [
    {
      "id": "AC1",
      "text": "With no pdd-workspace.json, policy loading reports unconfigured and does not read a missing file."
    },
    {
      "id": "AC2",
      "text": "A policy with allowed_paths [\"simulation/\", \"contracts/shared.md\"] retains those two entries in order and does not select Stories or add source includes."
    },
    {
      "id": "AC3",
      "text": "A present empty allowed_paths list reports a configured policy with no permitted authored paths."
    },
    {
      "id": "AC4",
      "text": "Malformed policy, unknown keys and unsafe path spellings are refused as workspace-config-invalid; no source content is read by policy loading."
    },
    {
      "id": "AC5",
      "text": "A linked or oversized policy is refused as workspace-config-unsafe before its content is read."
    }
  ],
