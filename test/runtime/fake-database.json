{
  "entry_path": "examples/fakes/database.prompt.md",
  "initial_world": {
    "database": {
      "schema": [
        "CREATE TABLE books (id INTEGER PRIMARY KEY, title TEXT NOT NULL)"
      ],
      "rows": {
        "books": [
          {
            "id": 1,
            "title": "Dune"
          }
        ]
      }
    }
  },
  "simulation": {
    "db.find": {
      "action": "sql.execute",
      "world_pointer": "/database",
      "statement": "SELECT title FROM books WHERE id = :id",
      "result_mode": "rows",
      "result_template": {
        "rows": []
      },
      "result_value_pointer": "/rows"
    }
  },
  "steps": [
    {
      "id": "seeded-book",
      "op": "findBook",
      "input": {
        "id": 1
      },
      "checks": {
        "1": [
          ["result", "/rows", "=", [{"title": "Dune"}]],
          ["world", "/database/rows/books", "=", [{"id": 1, "title": "Dune"}]]
        ]
      }
    }
  ]
}
