  "criteria": [
    {
      "id": "AC1",
      "text": "Running `pdd contracts` lists shared contract records, their prompt users and Stories, and reports Stories whose baseline reference snapshot changed as `stale: needs a new check`."
    },
    {
      "id": "AC2",
      "text": "Running `pdd contracts sync` previews matching schema copies without modifying files, and `pdd contracts sync --write` writes the updated prompt and reports the updated count."
    },
    {
      "id": "AC3",
      "text": "Invalid command syntax or running outside a Git repository writes a diagnostic to stderr and exits 2, and an empty `cwd` fails with `invalid-contracts-input`."
    }
  ],
