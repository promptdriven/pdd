{
  "schema_version": "prompt-runtime.program-scenario.v1",
  "story_path": "user_stories/new-command-names.md",
  "criteria": [
    {"id": "AC1", "text": "`pdd --help` lists `pdd <PROMPT.md|STORY|.>`, `pdd test`, and `pdd lint`, never says \"pdd check\", \"pdd try\", \"pdd sim\", \"pdd simulate\", or \"Simulator\", prints nothing to stderr, and exits with code 0."},
    {"id": "AC2", "text": "`pdd test --help` lists the `pdd test` forms with `--read`, `--retry`, `--files`, and `--screen`, prints nothing to stderr, and exits with code 0."},
    {"id": "AC3", "text": "`pdd lint --help` lists the `pdd lint` forms including `pdd lint --local`, prints nothing to stderr, and exits with code 0."},
    {"id": "AC4", "text": "`pdd check`, `pdd check --lint`, `pdd try`, `pdd simulate`, `pdd sim` (with any options, help flags, or after `pdd help`) each print nothing to stdout, print one refusal line to stderr naming the removed command and replacement, and exit with code 2 without side effects."},
    {"id": "AC5", "text": "`pdd test --bogus` prints a usage error to stderr with no \"Unknown command\" and no \"was removed\", prints nothing to stdout, and exits with code 2."},
    {"id": "AC6", "text": "`pdd prompts/app.prompt.md`, `pdd .`, `pdd --product`, and `pdd --stop` parse directly to the Prompt Interpreter without a subcommand, while typos like `pdd statis` exit with code 2 and `Unknown command \"statis\"`."}
  ],
  "initial_world": {},
  "simulation": {},
  "context": [],
  "steps": [
    {
      "step_id": "root-help-shows-direct-run-and-new-names",
      "entry_path": "prompts/cli/pdd-cli.prompt.md",
      "operation": "runPdd",
      "input": {"argv": ["--help"]},
      "checks": [
        {"criterion_id": "AC1", "target": "result", "path": "/stdout", "op": "contains", "value": "pdd <PROMPT.md|STORY|.>"},
        {"criterion_id": "AC1", "target": "result", "path": "/stdout", "op": "contains", "value": "pdd test"},
        {"criterion_id": "AC1", "target": "result", "path": "/stdout", "op": "contains", "value": "pdd lint"},
        {"criterion_id": "AC1", "target": "result", "path": "/stdout", "op": "not_contains", "value": "pdd check"},
        {"criterion_id": "AC1", "target": "result", "path": "/stdout", "op": "not_contains", "value": "pdd try"},
        {"criterion_id": "AC1", "target": "result", "path": "/stdout", "op": "not_contains", "value": "pdd sim"},
        {"criterion_id": "AC1", "target": "result", "path": "/stdout", "op": "not_contains", "value": "pdd simulate"},
        {"criterion_id": "AC1", "target": "result", "path": "/stdout", "op": "not_contains", "value": "Simulator"},
        {"criterion_id": "AC1", "target": "result", "path": "/stderr", "op": "equals", "value": ""},
        {"criterion_id": "AC1", "target": "result", "path": "/exit_code", "op": "equals", "value": 0}
      ]
    },
    {
      "step_id": "test-help-keeps-check-options",
      "entry_path": "prompts/cli/pdd-cli.prompt.md",
      "operation": "runPdd",
      "input": {"argv": ["test", "--help"]},
      "checks": [
        {"criterion_id": "AC2", "target": "result", "path": "/stdout", "op": "contains", "value": "pdd test --read"},
        {"criterion_id": "AC2", "target": "result", "path": "/stdout", "op": "contains", "value": "pdd test --retry"},
        {"criterion_id": "AC2", "target": "result", "path": "/stdout", "op": "contains", "value": "pdd test --files"},
        {"criterion_id": "AC2", "target": "result", "path": "/stdout", "op": "contains", "value": "pdd test --screen"},
        {"criterion_id": "AC2", "target": "result", "path": "/stderr", "op": "equals", "value": ""},
        {"criterion_id": "AC2", "target": "result", "path": "/exit_code", "op": "equals", "value": 0}
      ]
    },
    {
      "step_id": "lint-help-shows-lint-forms",
      "entry_path": "prompts/cli/pdd-cli.prompt.md",
      "operation": "runPdd",
      "input": {"argv": ["lint", "--help"]},
      "checks": [
        {"criterion_id": "AC3", "target": "result", "path": "/stdout", "op": "contains", "value": "pdd lint --local"},
        {"criterion_id": "AC3", "target": "result", "path": "/stderr", "op": "equals", "value": ""},
        {"criterion_id": "AC3", "target": "result", "path": "/exit_code", "op": "equals", "value": 0}
      ]
    },
    {
      "step_id": "check-help-is-removed",
      "entry_path": "prompts/cli/pdd-cli.prompt.md",
      "operation": "runPdd",
      "input": {"argv": ["check", "--help"]},
      "checks": [
        {"criterion_id": "AC4", "target": "result", "path": "/stdout", "op": "equals", "value": ""},
        {"criterion_id": "AC4", "target": "result", "path": "/stderr", "op": "equals", "value": "pdd check was removed. Use pdd test.\n"},
        {"criterion_id": "AC4", "target": "result", "path": "/exit_code", "op": "equals", "value": 2}
      ]
    },
    {
      "step_id": "check-lint-is-removed",
      "entry_path": "prompts/cli/pdd-cli.prompt.md",
      "operation": "runPdd",
      "input": {"argv": ["check", "--lint", "--help"]},
      "checks": [
        {"criterion_id": "AC4", "target": "result", "path": "/stdout", "op": "equals", "value": ""},
        {"criterion_id": "AC4", "target": "result", "path": "/stderr", "op": "equals", "value": "pdd check --lint was removed. Use pdd lint.\n"},
        {"criterion_id": "AC4", "target": "result", "path": "/exit_code", "op": "equals", "value": 2}
      ]
    },
    {
      "step_id": "simulate-help-is-removed",
      "entry_path": "prompts/cli/pdd-cli.prompt.md",
      "operation": "runPdd",
      "input": {"argv": ["simulate", "--help"]},
      "checks": [
        {"criterion_id": "AC4", "target": "result", "path": "/stdout", "op": "equals", "value": ""},
        {"criterion_id": "AC4", "target": "result", "path": "/stderr", "op": "equals", "value": "pdd simulate was removed. Run pdd <PROMPT.md|STORY> instead.\n"},
        {"criterion_id": "AC4", "target": "result", "path": "/exit_code", "op": "equals", "value": 2}
      ]
    },
    {
      "step_id": "sim-help-is-removed",
      "entry_path": "prompts/cli/pdd-cli.prompt.md",
      "operation": "runPdd",
      "input": {"argv": ["sim", "--help"]},
      "checks": [
        {"criterion_id": "AC4", "target": "result", "path": "/stdout", "op": "equals", "value": ""},
        {"criterion_id": "AC4", "target": "result", "path": "/stderr", "op": "equals", "value": "pdd sim was removed. Run pdd <PROMPT.md|STORY> instead.\n"},
        {"criterion_id": "AC4", "target": "result", "path": "/exit_code", "op": "equals", "value": 2}
      ]
    },
    {
      "step_id": "try-help-is-removed",
      "entry_path": "prompts/cli/pdd-cli.prompt.md",
      "operation": "runPdd",
      "input": {"argv": ["try", "--help"]},
      "checks": [
        {"criterion_id": "AC4", "target": "result", "path": "/stdout", "op": "equals", "value": ""},
        {"criterion_id": "AC4", "target": "result", "path": "/stderr", "op": "equals", "value": "pdd try was removed. Run pdd <PROMPT.md|STORY> instead.\n"},
        {"criterion_id": "AC4", "target": "result", "path": "/exit_code", "op": "equals", "value": 2}
      ]
    },
    {
      "step_id": "test-unknown-option",
      "entry_path": "prompts/cli/pdd-cli.prompt.md",
      "operation": "runPdd",
      "input": {"argv": ["test", "--bogus"]},
      "checks": [
        {"criterion_id": "AC5", "target": "result", "path": "/stderr", "op": "not_equals", "value": ""},
        {"criterion_id": "AC5", "target": "result", "path": "/stderr", "op": "not_contains", "value": "Unknown command"},
        {"criterion_id": "AC5", "target": "result", "path": "/stderr", "op": "not_contains", "value": "was removed"},
        {"criterion_id": "AC5", "target": "result", "path": "/stdout", "op": "equals", "value": ""},
        {"criterion_id": "AC5", "target": "result", "path": "/exit_code", "op": "equals", "value": 2}
      ]
    },
    {
      "step_id": "direct-help",
      "entry_path": "prompts/cli/pdd-cli.prompt.md",
      "operation": "runPdd",
      "input": {"argv": [".", "--help"]},
      "checks": [
        {"criterion_id": "AC6", "target": "result", "path": "/stdout", "op": "contains", "value": "pdd [OPTIONS] <PROMPT.md|app-map.json> [ARGS...]"},
        {"criterion_id": "AC6", "target": "result", "path": "/stdout", "op": "not_contains", "value": "pdd sim"},
        {"criterion_id": "AC6", "target": "result", "path": "/stdout", "op": "not_contains", "value": "Simulator"},
        {"criterion_id": "AC6", "target": "result", "path": "/stderr", "op": "equals", "value": ""},
        {"criterion_id": "AC6", "target": "result", "path": "/exit_code", "op": "equals", "value": 0}
      ]
    },
    {
      "step_id": "direct-help-and-typo-refusal",
      "entry_path": "prompts/cli/pdd-cli.prompt.md",
      "operation": "runPdd",
      "input": {"argv": ["statis"]},
      "checks": [
        {"criterion_id": "AC6", "target": "result", "path": "/stdout", "op": "equals", "value": ""},
        {"criterion_id": "AC6", "target": "result", "path": "/stderr", "op": "equals", "value": "Unknown command \"statis\". Run pdd --help to see the commands.\n"},
        {"criterion_id": "AC6", "target": "result", "path": "/exit_code", "op": "equals", "value": 2}
      ]
