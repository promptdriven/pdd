{
  "schema_version": "prompt-runtime.program-scenario.v1",
  "story_path": "user_stories/new-command-names.md",
  "criteria": [
    {"id": "AC1", "text": "`pdd --help` lists `pdd test`, `pdd lint`, `pdd simulate` and `pdd workflow start`, never says \"pdd check\", \"pdd try\" or \"workflow run\", prints nothing to stderr and exits with code 0."},
    {"id": "AC2", "text": "`pdd test --help` lists the `pdd test` forms with --read, --retry, --fill-hash, --files and --screen, prints nothing to stderr and exits with code 0."},
    {"id": "AC3", "text": "`pdd lint --help` lists the `pdd lint` forms, including `pdd lint --local`, prints nothing to stderr and exits with code 0."},
    {"id": "AC4", "text": "`pdd check --help` prints the `pdd test` help to stdout, prints one notice line to stderr that names `pdd check` and `pdd test`, and exits with code 0."},
    {"id": "AC5", "text": "`pdd check --lint --help` prints the `pdd lint` help to stdout, prints one notice line to stderr that names `pdd check --lint` and `pdd lint`, and exits with code 0."},
    {"id": "AC6", "text": "`pdd try --help` prints the `pdd simulate` help to stdout, prints one notice line to stderr that names `pdd try` and `pdd simulate`, and exits with code 0."},
    {"id": "AC7", "text": "`pdd workflow run --help` prints the `pdd workflow start` help to stdout, prints one notice line to stderr that names `pdd workflow run` and `pdd workflow start`, and exits with code 0."},
    {"id": "AC8", "text": "`pdd workflow start 81` tells me on stderr to name the workflow with `pdd workflow start small-change 81`, prints nothing to stdout and exits with code 2."},
    {"id": "AC9", "text": "`pdd workflow run 81` still prints only \"Name the workflow: pdd workflow run small-change 81 (or bug, feature). See pdd workflow list.\" to stderr, with no notice, prints nothing to stdout and exits with code 2."},
    {"id": "AC10", "text": "`pdd test --bogus` and `pdd check --bogus` each print a usage error to stderr, with no notice and no \"Unknown command\", print nothing to stdout and exit with code 2."},
    {"id": "AC11", "text": "`pdd sim --help` prints the `pdd simulate` help to stdout, prints nothing to stderr and exits with code 0."}
  ],
  "initial_world": {},
  "simulation": {},
  "context": [],
  "steps": [
    {
      "step_id": "root-help-shows-new-names",
      "entry_path": "prompts/cli/pdd-cli.prompt.md",
      "operation": "runPdd",
      "input": {"argv": ["--help"]},
      "checks": [
        {"criterion_id": "AC1", "target": "result", "path": "/stdout", "op": "contains", "value": "pdd test"},
        {"criterion_id": "AC1", "target": "result", "path": "/stdout", "op": "contains", "value": "pdd lint"},
        {"criterion_id": "AC1", "target": "result", "path": "/stdout", "op": "contains", "value": "pdd simulate"},
        {"criterion_id": "AC1", "target": "result", "path": "/stdout", "op": "contains", "value": "pdd workflow start"},
        {"criterion_id": "AC1", "target": "result", "path": "/stdout", "op": "not_contains", "value": "pdd check"},
        {"criterion_id": "AC1", "target": "result", "path": "/stdout", "op": "not_contains", "value": "pdd try"},
        {"criterion_id": "AC1", "target": "result", "path": "/stdout", "op": "not_contains", "value": "workflow run"},
        {"criterion_id": "AC1", "target": "result", "path": "/stderr", "op": "equals", "value": ""},
        {"criterion_id": "AC1", "target": "result", "path": "/exit_code", "op": "equals", "value": 0}
      ]
    },
    {
      "step_id": "test-help-keeps-check-options",
      "entry_path": "prompts/cli/pdd-cli.prompt.md",
      "operation": "runPdd",
      "input": {"argv": ["test", "--help"]},
