        {"criterion_id": "AC2", "target": "result", "path": "/stdout", "op": "contains", "value": "pdd test --fill-hash"},
        {"criterion_id": "AC2", "target": "result", "path": "/stdout", "op": "contains", "value": "pdd test --files"},
        {"criterion_id": "AC2", "target": "result", "path": "/stdout", "op": "contains", "value": "pdd test --screen"},
        {"criterion_id": "AC2", "target": "result", "path": "/stderr", "op": "equals", "value": ""},
        {"criterion_id": "AC2", "target": "result", "path": "/exit_code", "op": "equals", "value": 0}
      ]
