{
  "schema_version": "prompt-runtime.program-scenario.v1",
  "story_path": "user_stories/new-command-names.md",
  "criteria": [
    {"id": "ac-sha256-e3ad99361124ab3cc0838e0b62dc347a175f6d3447152add", "text": "`pdd --help` lists `pdd test`, `pdd lint`, `pdd simulate` and `pdd workflow run`, never says \"pdd check\", \"pdd try\" or \"workflow start\", prints nothing to stderr and exits with code 0."},
    {"id": "ac-sha256-3570ad0c79cc9308ec29c301dfd8a745de09cab483583d1a", "text": "`pdd test --help` lists the `pdd test` forms with --read, --retry, --files and --screen, prints nothing to stderr and exits with code 0."},
    {"id": "ac-sha256-a5f794ba8456df0689747cefddac813899b82cf5e5e87056", "text": "`pdd lint --help` lists the `pdd lint` forms, including `pdd lint --local`, prints nothing to stderr and exits with code 0."},
    {"id": "ac-sha256-71691038773863c4ff50881af8fd665dfbb0c70741f3a6a6", "text": "`pdd check --help` prints nothing to stdout, prints one line to stderr that names `pdd check` and `pdd test`, and exits with code 2."},
    {"id": "ac-sha256-a65ea76e60e0d584514dd0fe6b1518157e7898fcc0e6b03f", "text": "`pdd check --lint --help` and `pdd check new-command-names --lint` each print nothing to stdout, print one line to stderr that names `pdd check --lint` and `pdd lint`, and exit with code 2."},
    {"id": "ac-sha256-412140e4f51f2651dacfbc9e4974113268efd92b6ffed450", "text": "`pdd try --help` prints nothing to stdout, prints one line to stderr that names `pdd try` and `pdd simulate`, and exits with code 2."},
    {"id": "ac-sha256-b14fc2666450214bcfd695d826d50517464e88a0a35227ce", "text": "`pdd help check` and `pdd help try` each print nothing to stdout, print one line to stderr that names the old and the new command, and exit with code 2."},
    {"id": "ac-sha256-f782343f31c75d4633614f13b064068e9f0acd9064f9b100", "text": "`pdd check new-command-names --json`, `pdd check --bogus` and `pdd try new-command-names --new` each print nothing to stdout, print one line to stderr that names the old and the new command, and exit with code 2."},
    {"id": "ac-sha256-f12bae9827329ddc08df713556553d6ed55c5db3ed396da5", "text": "`pdd workflow run --help` prints the `pdd workflow run` help to stdout, prints nothing to stderr and exits with code 0."},
    {"id": "ac-sha256-343754202c6ab03e9842ed8efcc741c6243742aef29ec1c9", "text": "`pdd workflow start --help` prints the same `pdd workflow run` help to stdout, never says \"workflow start\", prints nothing to stderr and exits with code 0."},
    {"id": "ac-sha256-20c3c8300d5345c1b6c678de31e60b8a46df9a0e012fbfee", "text": "`pdd workflow run 81` still prints only \"Name the workflow: pdd workflow run small-change 81 (or bug, feature). See pdd workflow list.\" to stderr, prints nothing to stdout and exits with code 2."},
    {"id": "ac-sha256-244456ee9d517a28f5e60411f8beb05d37f12fc398c52009", "text": "`pdd workflow start 81` prints only the same line, \"Name the workflow: pdd workflow run small-change 81 (or bug, feature). See pdd workflow list.\", to stderr, prints nothing to stdout and exits with code 2."},
    {"id": "ac-sha256-addfc248fbefa17d89dc68d812d6f0b814bfb177375def5f", "text": "`pdd test --bogus` prints a usage error to stderr, with no \"Unknown command\" and no \"was removed\", prints nothing to stdout and exits with code 2."},
    {"id": "ac-sha256-78367a6d8efce76eee27f2f7eff677a1d2955ee143a43f24", "text": "`pdd sim --help` prints the `pdd simulate` help to stdout, prints nothing to stderr and exits with code 0."}
  ],
