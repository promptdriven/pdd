{
  "schema_version": "prompt-runtime.program-scenario.v1",
  "story_path": "user_stories/skills-install-ports.md",
  "criteria": [
    {
      "id": "AC1",
      "text": "`setupSkills` updates an older `.pdd-skill.json`-marked skill in `.agents/skills` under `home`, recognizes `.agents/skills` under `cwd` when all ten skills exist there (reporting `stale: \"older\"` for an un-marked copy with an older `pdd-skills` version), installs a missing skill into `skills` under `claudeConfigDir` when `claudeConfigDir` is an absolute path, and fails with `missing_skills_package` when `package.json` under `packageRoot` is missing."
    },
    {
      "id": "AC2",
      "text": "`findSkills` performs read-only discovery and stale classification without calling `fs.copySkill`, and fails with `missing_skills_package` when `package.json` under `packageRoot` is missing."
    }
  ],
