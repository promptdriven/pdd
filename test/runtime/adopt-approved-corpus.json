{
  "schema_version": "prompt-runtime.program-scenario.v1",
  "story_path": "user_stories/adopt-approved-corpus.md",
  "criteria": [
    {"id": "AC1", "text": "I can start a fresh evidence-enabled workflow with my complete declared unchanged corpus from an explicitly identified approved commit, without editing its scenarios or reapproving unchanged prompt content."},
    {"id": "AC2", "text": "I see adoption refused for a foreign source, unavailable approved snapshot, an approved commit unrelated to my selected base, or missing explicit external human approval assertion."},
    {"id": "AC3", "text": "I see adoption refused when a declared scenario is omitted or missing, the selected inventory has extra rows, or its raw bytes or original check identities change."},
    {"id": "AC4", "text": "I see adoption refused when the current prompt or any required dependency differs from the approved source."},
    {"id": "AC5", "text": "I keep the original repository, commit, declared scenario scope and human approval reference, with a clear warning that pdd cannot independently authenticate that external authorization."}
  ],
