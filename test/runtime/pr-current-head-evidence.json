  "criteria": [
    {
      "id": "AC1",
      "text": "After checked files change or disappear, or their current source cannot be verified, the PR shows no current successful check or count for that saved result."
    },
    {
      "id": "AC2",
      "text": "Unchanged checked content can retain its current result across commits; newer compatible evidence updates the same Story without restoring an older overall total."
    },
    {
      "id": "AC3",
      "text": "Agent prose, including \"Full npm test: 665/665 passed\", ordinary proof, warnings and failures, stays under \"Agent note — not checked by pdd\"; only structured current-head CI or the old-code proof run supplies checked native-suite counts, otherwise they are unknown."
    },
    {
      "id": "AC4",
      "text": "A missing machine proof remains \"not run\" and an unreadable proof remains \"unavailable\"; neither prevents publication."
    },
    {
      "id": "AC5",
      "text": "A criterion with one or more checks, all checking exit code across every step, says \"checked by exit code only\", regardless of its wording or result; checks assigned to other criteria do not affect this fact."
    },
    {
      "id": "AC6",
      "text": "A criterion with mixed checks or zero checks has no exit-code-only annotation; unavailable authored checks remain unknown. No new warning, refusal or verdict change is added."
    }
  ],
