{
  "schema_version": "prompt-runtime.program-scenario.v1",
  "story_path": "user_stories/pr-current-head-evidence.md",
  "criteria": [
    {
      "id": "AC1",
      "text": "After checked files change or disappear, or their current source cannot be verified, the PR shows no current successful check or count for that saved result."
    },
    {
      "id": "AC2",
      "text": "Unchanged checked content can retain its current result across commits; newer compatible evidence updates the same Story without restoring an older overall total."
    },
    {
      "id": "AC3",
      "text": "Without current machine evidence, a PR does not present \"Full npm test: 665/665 passed\" typed in a verification note or summary as checked evidence; ordinary proof prose and not-checked warnings remain visible."
    },
    {
      "id": "AC4",
      "text": "A missing machine proof remains \"not run\" and an unreadable proof remains \"unavailable\"; neither prevents publication."
    },
    {
      "id": "AC5",
      "text": "When \"the release prints only the release version\" has only an exit-code assertion, pdd warns that the output is unchecked and still accepts the test."
    },
    {
      "id": "AC6",
      "text": "Adding an output assertion for that criterion removes the exit-only warning; a criterion promising only a successful exit needs no output warning."
    }
  ],
