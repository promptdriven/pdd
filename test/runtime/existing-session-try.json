{
  "schema_version": "prompt-runtime.program-scenario.v1",
  "story_path": "user_stories/existing-session-try.md",
  "criteria": [
    {
      "id": "AC1",
      "text": "Supplying `try_id` \"520c7aa5-72f6-4add-b60e-8ed87db656c2\" binds only that running simulation with its pinned `source_sha256` and call cap 40 (40 remaining), and refuses a missing, paused, stopped or cap-mismatched Try ID without opening or reopening a session."
    },
    {
      "id": "AC2",
      "text": "Running a pure JSON prompt on that bound Try returns the confirmed outcome or declared error \"invalid-quantity\" with external `run_id` and internal `action_id`, uses 1 call on the first run and marks an exact repeat as `replayed: true` with 0 calls."
    },
    {
      "id": "AC3",
      "text": "Observing `run_id` \"7b409bce-ede1-40a5-ba87-ae67cbf516b0\" on Try \"520c7aa5-72f6-4add-b60e-8ed87db656c2\" returns its read-only `state`, `session_state` (including \"stopped\"), external `run_id` and internal `action_id` \"605cd2d9e23745f990720a7a5103490c\", and marks an \"unknown\" call as `unknown_outcome: true` without replaying it."
    },
    {
      "id": "AC4",
      "text": "`pdd simulate --stop 520c7aa5-72f6-4add-b60e-8ed87db656c2` selects only that saved simulation to stop and refuses an unknown Try ID."
    }
  ],
