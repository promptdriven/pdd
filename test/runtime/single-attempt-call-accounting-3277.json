  "criteria": [
    {
      "id": "AC1",
      "text": "When a single check attempt dispatches 34 provider calls with 33 known calls and 1 unknown call, `pdd test` reports `\"calls\": \"unknown\"`, `\"known_calls\": 33`, `\"unknown_calls\": 1` and `\"accounting_complete\": false` in JSON and `\"33 AI calls + 1 unknown\"` in the Prompt tests summary line."
    },
    {
      "id": "AC2",
      "text": "When a single check attempt dispatches 34 provider calls with 1 unknown call and omits `\"known_calls\"`, `pdd test` subtracts the 1 unknown call from the 34 dispatched calls and reports `\"calls\": \"unknown\"`, `\"known_calls\": 33`, `\"unknown_calls\": 1` and `\"accounting_complete\": false`."
    },
    {
      "id": "AC3",
      "text": "When a single check attempt completes with 3 calls, 2 known calls, 0 unknown calls and complete accounting, `pdd test` keeps `\"calls\": 3`, `\"unknown_calls\": 0` and `\"accounting_complete\": true`."
    }
  ],
  "initial_world": {},
  "simulation": {},
  "context": [],
