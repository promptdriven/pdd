{
  "schema_version": "prompt-runtime.program-scenario.v1",
  "story_path": "user_stories/exact-calc-command.md",
  "criteria": [
    {
      "id": "ac-sha256-587c589baa0dac258ee9543952c39f884e95d09ffbcfcbc7",
      "text": "Running `pdd calc \"4000 - floor(4000 * 540 / 10000)\"` prints \"3784\" and running `pdd calc \"0.1 + 0.2\"` prints \"0.3\", each to stdout with empty stderr and exit code 0."
    },
    {
      "id": "ac-sha256-34f407b3ae07b90cc1a3831e216d019b78d35a6f62af958f",
      "text": "Running `pdd calc \"-7 div 2\"` prints \"-3\" and running `pdd calc \"-7 mod 2\"` prints \"-1\", using truncation toward zero with empty stderr and exit code 0."
    },
    {
      "id": "ac-sha256-c64094f7c5dc4344d8499af955aaf69e54971f67b2c41e4d",
      "text": "Running `pdd calc \"1 / 3\"` prints \"1/3\" and running `pdd calc \"-4 / 6\"` prints \"-2/3\", printing nonterminating quotients as reduced fractions with a positive denominator, empty stderr and exit code 0."
    },
    {
      "id": "ac-sha256-5ab2fc22fc1dfd6dbd25e02ab87ae9e6a35720197a480c62",
      "text": "Running `pdd calc` on \"round_half_up(2.5)\", \"round_half_up(-2.5)\", \"round_half_even(2.5)\", \"round_half_even(3.5)\", and \"max(ceil(1.2), trunc(-2.9), min(10, 5))\" prints \"3\", \"-3\", \"2\", \"4\", and \"5\" respectively, with empty stderr and exit code 0."
    },
    {
      "id": "ac-sha256-59ef45227a6fa4aea6ec9ba9d9d07277c540c8ccefd477e3",
      "text": "Running `pdd calc` on a blank expression, division by zero (\"1 / 0\"), or an unknown function (\"foo(1)\") prints nothing to stdout, writes one \"pdd calc:\" error line to stderr, and exits with code 2."
    }
  ],
