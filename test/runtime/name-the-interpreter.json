{
  "schema_version": "prompt-runtime.program-scenario.v1",
  "story_path": "user_stories/name-the-interpreter.md",
  "criteria": [
    {"id": "AC1", "text": "`pdd --help` calls the hosted service the \"PDD interpreter\", never says \"PDD runtime\" or \"runtime call\", prints nothing to stderr and exits with code 0."},
    {"id": "AC2", "text": "`pdd test --help` says that it checks Stories on the PDD interpreter with my gh login, never says \"PDD runtime\" and exits with code 0."},
    {"id": "AC3", "text": "`pdd lint --help` says that it runs the PDD interpreter lint with 0 AI calls, never says \"PDD runtime\" and exits with code 0."},
    {"id": "AC4", "text": "`pdd simulate --help` says that it opens the PDD Simulator on the PDD interpreter, never says \"PDD runtime\" and exits with code 0."},
    {"id": "AC5", "text": "`pdd product --help` says that the product commands make no interpreter calls, never says \"runtime\" and exits with code 0."},
    {"id": "AC6", "text": "`pdd approve --help` still says \"runtime interface\", the name of the block in a prompt file, prints nothing to stderr and exits with code 0."}
  ],
  "initial_world": {},
  "simulation": {},
  "context": [],
  "steps": [
    {
      "step_id": "root-help-names-the-interpreter",
      "entry_path": "prompts/cli/pdd-cli.prompt.md",
      "operation": "runPdd",
      "input": {"argv": ["--help"]},
      "checks": [
        {"criterion_id": "AC1", "target": "result", "path": "/stdout", "op": "contains", "value": "PDD interpreter"},
        {"criterion_id": "AC1", "target": "result", "path": "/stdout", "op": "not_contains", "value": "PDD runtime"},
        {"criterion_id": "AC1", "target": "result", "path": "/stdout", "op": "not_contains", "value": "runtime call"},
        {"criterion_id": "AC1", "target": "result", "path": "/stderr", "op": "equals", "value": ""},
        {"criterion_id": "AC1", "target": "result", "path": "/exit_code", "op": "equals", "value": 0}
      ]
    },
    {
      "step_id": "test-help-names-the-interpreter",
      "entry_path": "prompts/cli/pdd-cli.prompt.md",
      "operation": "runPdd",
      "input": {"argv": ["test", "--help"]},
      "checks": [
        {"criterion_id": "AC2", "target": "result", "path": "/stdout", "op": "contains", "value": "PDD interpreter"},
        {"criterion_id": "AC2", "target": "result", "path": "/stdout", "op": "contains", "value": "gh login"},
        {"criterion_id": "AC2", "target": "result", "path": "/stdout", "op": "not_contains", "value": "PDD runtime"},
        {"criterion_id": "AC2", "target": "result", "path": "/exit_code", "op": "equals", "value": 0}
      ]
    },
    {
