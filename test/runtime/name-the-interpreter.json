  "criteria": [
    {"id": "ac-sha256-2ad194314052e435f1636417cf9d8e7fca36e796396f7dbf", "text": "`pdd --help` calls the hosted service the \"PDD interpreter\", never says \"PDD runtime\" or \"runtime call\", prints nothing to stderr and exits with code 0."},
    {"id": "ac-sha256-3a90f192c046287f45eae41774871a11aad62f8c5417dd96", "text": "`pdd test --help` says that it checks Stories on the PDD interpreter with my gh login, never says \"PDD runtime\" and exits with code 0."},
    {"id": "ac-sha256-e27e18a3059e59a864142ec4874bbd7b6f97864ebbb6a402", "text": "`pdd lint --help` says that it runs the PDD interpreter lint with 0 AI calls, never says \"PDD runtime\" and exits with code 0."},
    {"id": "ac-sha256-3d3c69944c9c60b3bc296162e1b716c044a031dcaa2dfd07", "text": "`pdd simulate --help` says that it opens the PDD Simulator on the PDD interpreter, never says \"PDD runtime\" and exits with code 0."},
    {"id": "ac-sha256-f99094c87f5d9250df35f6212e412be9fd5aafb7289bd59b", "text": "`pdd product --help` says that the product commands make no interpreter calls, never says \"runtime\" and exits with code 0."},
    {"id": "ac-sha256-2a0258cf06bb7f0fa7992e289db215ecfabe4c13fafcd28a", "text": "`pdd approve --help` still says \"runtime interface\", the name of the block in a prompt file, prints nothing to stderr and exits with code 0."}
  ],
