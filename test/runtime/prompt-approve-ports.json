      "entry_path": "prompts/cli/prompt-approve.prompt.md",
      "operation": "approvePromptText",
      "input": {
        "text": "# Sample prompt\n\n<details><summary>Runtime interface</summary>\n\n```json\n{\"status\":\"draft\"}\n```\n</details>\n"
      },
      "checks": [
        {
          "criterion_id": "AC1",
          "target": "result",
          "path": "/text",
          "op": "equals"
        }
      ]
    },
    {
      "step_id": "approve-accepted-said-records-owner-evidence",
      "entry_path": "prompts/cli/prompt-approve.prompt.md",
      "operation": "runApprove",
      "input": {
        "words": [
          "prompts/cli/sample.prompt.md"
        ],
        "cwd": "/repo",
        "said": "Approve the sample prompt."
      },
      "checks": [
        {
          "criterion_id": "AC2",
          "target": "result",
          "path": "/exitCode",
          "op": "equals",
          "value": 0
        },
        {
          "criterion_id": "AC2",
          "target": "world",
          "path": "/files/~1repo~1prompts~1cli~1sample.prompt.md/content",
          "op": "contains",
          "value": "\"status\": \"approved\""
        },
        {
          "criterion_id": "AC2",
          "target": "world",
          "path": "/files/~1repo~1.git~1pdd~1approvals.json/content",
          "op": "equals",
          "value": "Approve the sample prompt.",
          "json_path": "/approvals/0/words"
        },
        {
          "criterion_id": "AC2",
          "target": "world",
          "path": "/files/~1repo~1.git~1pdd~1approvals.json/content",
          "op": "equals",
          "value": "said",
          "json_path": "/approvals/0/route"
        }
      ]
    },
    {
      "step_id": "strict-mode-refuses-said-before-write",
      "entry_path": "prompts/cli/prompt-approve.prompt.md",
      "operation": "runApprove",
      "input": {
        "words": [
          "prompts/cli/sample.prompt.md"
        ],
        "cwd": "/strict-repo",
        "said": "Approve in strict mode."
      },
      "checks": [
