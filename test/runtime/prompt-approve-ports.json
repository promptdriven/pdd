  "steps": [
    {
      "step_id": "approve-text-preserves-nested-status",
      "entry_path": "prompts/cli/prompt-approve.prompt.md",
      "operation": "approvePromptText",
      "input": {
        "text": "# Sample prompt\n\nSay hello.\n\n```json\n{\n  \"status\": \"draft\",\n  \"prose_sha256\": \"\",\n  \"entries\": [\n    {\n      \"operation\": \"showStatus\",\n      \"input_schema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"status\": {\n            \"type\": \"string\",\n            \"const\": \"draft\"\n          }\n        },\n        \"required\": [],\n        \"additionalProperties\": false\n      },\n      \"result_schema\": {\n        \"type\": \"string\"\n      },\n      \"errors\": []\n    }\n  ],\n  \"calls\": [],\n  \"resources\": [],\n  \"limits\": {\n    \"max_steps\": 1,\n    \"max_model_calls\": 1\n  }\n}\n```\n</details>\n"
      },
      "checks": [
        {
          "criterion_id": "AC1",
          "target": "result",
          "path": "/text",
          "op": "contains",
          "value": "\"status\": \"approved\""
        },
        {
          "criterion_id": "AC1",
          "target": "result",
          "path": "/text",
          "op": "contains",
          "value": "\"const\": \"draft\""
        }
      ]
    },
    {
