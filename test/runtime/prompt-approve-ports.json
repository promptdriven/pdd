  "story_path": "user_stories/prompt-approve-ports.md",
  "criteria": [
    {
      "id": "AC1",
      "text": "approvePromptText sets only the top-level approval fields using the native prose hash, leaves nested status fields untouched, and returns null when the interface cannot be safely updated."
    },
    {
      "id": "AC2",
      "text": "runApprove with accepted said words writes the approved prompt and records complete durable evidence through the shared approval-policy owner."
    },
    {
      "id": "AC3",
      "text": "runApprove in strict mode refuses said words with exit code 2 before it writes the prompt or records approval evidence."
    },
    {
      "id": "AC4",
      "text": "runApprove with blank cwd returns exit code 2 with the Git repository diagnostic before file or policy reads."
    }
  ],
