{
  "schema_version": "prompt-runtime.program-scenario.v1",
  "story_path": "user_stories/safe-package-update.md",
  "criteria": [
    {
      "id": "AC1",
      "text": "`pdd setup` and `pdd autopilot doctor` warn about the old npm name `pdd` and show `npm uninstall -g pdd && npm install -g github:promptdriven/pdd`, without changing installed packages."
    },
    {
      "id": "AC2",
      "text": "With the scoped GitHub distribution and no old package, setup and doctor warn against `npm update -g` for pdd and show `npm install -g github:promptdriven/pdd`."
    },
    {
      "id": "AC3",
      "text": "An installed scoped package also detects the old global package beside it and shows the migration command; a source checkout does not mistake a project-local pdd folder for a global install."
    },
    {
      "id": "AC4",
      "text": "Missing or malformed package metadata does not stop setup or doctor or produce a false legacy migration warning."
    }
  ],
