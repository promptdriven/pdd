{
  "schema_version": "prompt-runtime.program-scenario.v1",
  "story_path": "user_stories/workflow-launch-profile-ports.md",
  "criteria": [
    {
      "id": "AC1",
      "text": "`launchProfile` computes the deterministic `pdd-` plus 12-hex prefix from `repository` and `runId` and fails with `invalid_launch_profile` when the agent is unsupported."
    },
    {
      "id": "AC2",
      "text": "`chatAgentName` appends `-` plus 6-hex from `repository`, `runId` and `area` to the profile prefix and fails with `invalid_launch_profile` when `area` is empty."
    },
    {
      "id": "AC3",
      "text": "`selectLaunchProfile` reads `config.toml` under `configDir` when a Codex thread limit is requested, preserves a higher `features.multi_agent_v2.max_concurrent_threads_per_session` limit, and fails with `invalid_launch_profile` on a leading-dash model or invalid option."
    },
    {
      "id": "AC4",
      "text": "`validLaunchProfile` accepts a saved profile whose effective Codex thread limit exceeds 8, and fails with `invalid_launch_profile` when `requireValid` is `true` on an invalid profile."
    }
  ],
  "initial_world": {
    "files": {
      "/home/dev/.codex-work/config.toml": {
        "content": "[features.multi_agent_v2]\nmax_concurrent_threads_per_session = 12\n",
        "is_symlink": false
      }
    }
  },
