{
  "schema_version": "prompt-runtime.program-scenario.v1",
  "story_path": "user_stories/svg-layout-ports.md",
  "criteria": [
    {
      "id": "AC1",
      "text": "A prompt whose controls, labels and layout regions match its linked `.ui.svg` drawing produces no warnings."
    },
    {
      "id": "AC2",
      "text": "Disagreements between a prompt and its linked `.ui.svg` drawing report missing controls, unmentioned drawing labels and unspecified drawing regions in deterministic order."
    },
    {
      "id": "AC3",
      "text": "A prompt linking to a missing `.ui.svg` drawing reports a drawing warning, and an invalid `pdd-workspace.json` fails with `workspace-config-invalid`."
    }
  ],
  "initial_world": {
    "files": {
      "/repo/prompts/screen/clean.prompt.md": {
        "content": "# Clean screen\n\nShow the BOARD region and a button with id=\"start-game\" labeled \"Start\".\n\n## Appearance\n\n![Clean screen](clean.ui.svg)\n\nUse `board` and `start-game`.\n",
        "is_symlink": false
      },
      "/repo/prompts/screen/clean.ui.svg": {
        "content": "<svg viewBox=\"0 0 200 100\"><g id=\"board\"><text>BOARD</text></g><g id=\"start-game\"><text>Start</text></g></svg>\n",
        "is_symlink": false
      },
      "/repo/prompts/screen/mismatch.prompt.md": {
        "content": "# Mismatch screen\n\nProvide a button with id=\"reset-btn\" and show the current score.\n\n![Mismatch screen](mismatch.ui.svg)\n",
        "is_symlink": false
      },
      "/repo/prompts/screen/mismatch.ui.svg": {
        "content": "<svg viewBox=\"0 0 200 100\"><g id=\"score\"><text>SCORE</text><text>READY</text></g></svg>\n",
        "is_symlink": false
      },
      "/repo/prompts/screen/missing.prompt.md": {
        "content": "# Missing drawing\n\n![Missing](absent.ui.svg)\n",
        "is_symlink": false
      },
      "/bad-repo/pdd-workspace.json": {
        "content": "{\"allowed_paths\":[\"../escape\"]}\n",
        "is_symlink": false
      }
    }
  },
  "simulation": {
