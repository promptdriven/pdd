  "criteria": [
    {
      "id": "AC1",
      "text": "`interpreterQueueEnvironment`, `acquireInterpreterSlot`, `markInterpreterDispatch` and `observeInterpreterRequest` resolve queue settings, allocate and mark running tickets, record terminal verdicts in `ticket-1.json` and `capacity.json`, and raise `local-state-unavailable` for relative paths, duplicate requests or repeated dispatch marks."
    },
    {
      "id": "AC2",
      "text": "`readInterpreterProgress`, `interpreterStatusWords` and `configureInterpreterTestMode` report ticket progress and status lines, persist test-mode owner leases in `capacity.json`, and return empty progress or raise `local-state-unavailable` when no matching records exist or the owner is blank."
    }
  ],
