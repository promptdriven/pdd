  "criteria": [
    {
      "id": "AC1",
      "text": "Changing \"kept\" to skip and adding \"later\" as todo lists both new marker lines, while an existing unchanged skip is not listed as new."
    },
    {
      "id": "AC2",
      "text": "Adding an expected-failure decorator to a kept Python test lists that new marker; a Go test remains counted by name."
    },
    {
      "id": "AC3",
      "text": "No changed test files produces explicit none categories; invalid commit identities produce unavailable without reading a snapshot."
    }
  ],
