        {
          "criterion_id": "AC1",
          "target": "result",
          "path": "/text",
          "op": "equals",
          "value": "Tests vs base: \"test/a.test.mjs\" 2 → 3 tests. Removed: none.\nChanged assertions in kept tests: none.\nNew skips: \"test/a.test.mjs\" \"kept\" \"test.skip('kept', () =&#62; {});\".\nNew skips: \"test/a.test.mjs\" \"later\" \"test.todo('later');\".\nStatic inventory only; tests were not run.\n"
        },
        {
          "criterion_id": "AC1",
