{
  "schema_version": "prompt-runtime.program-scenario.v1",
  "story_path": "user_stories/workflow-areas-ports.md",
  "criteria": [
    {
      "id": "AC1",
      "text": "Reading a bundled workflow skips any home copy with the same name, returns the package definition with `before`, `then` and `replay_evidence` preserved, and reading a custom home single-area `pr` workflow adds the missing-approve-gate advisory."
    },
    {
      "id": "AC2",
      "text": "Reading an unknown workflow fails with `workflow_unknown`."
    },
    {
      "id": "AC3",
      "text": "Listing workflows across project, home and package skill folders returns them sorted by name with project overrides winning over bundled workflows."
    },
    {
      "id": "AC4",
      "text": "Listing workflows fails with `workflow_invalid` when a winning `workflow.json` violates the version or area gate rules."
    },
    {
      "id": "AC5",
      "text": "Formatting a workflow list renders plain-text area gates (`approve → pr` for `before: \"approve\"`), advisories and the no-work footer, and rejects a workflow record with no areas with `invalid_workflow_list`."
    }
  ],
