{
  "schema_version": "prompt-runtime.program-scenario.v1",
  "story_path": "user_stories/autopilot-intake-preflight.md",
  "criteria": [
    {
      "id": "ac-sha256-7ecfcac2b1cccdca8890ff3929ad60e45802d46bfed53c46",
      "text": "Before claiming an issue that requires coordinated edits in another repository such as `pdd_cloud` or `pdd-workflow`, Autopilot rejects it as cross-repo, marks it `needs-other-repo`, and records a crisp skip reason."
    },
    {
      "id": "ac-sha256-5106f2785f342675aeb0c20056de95d2086db12bcaf21cfc",
      "text": "Before claiming an issue that asks an unanswered product, pricing, or UX policy decision, Autopilot parks it for a person with `pdd:needs-decision`, asks one concise question, and records a crisp skip reason; once a trusted person answers the decision in a comment, Autopilot allows it."
    },
    {
      "id": "ac-sha256-191fc0f4985a0d40e86e73370167ffef6dbbe86b2f76055a",
      "text": "Before claiming an issue whose required verification depends on an external service, live production credentials, or manual human QA unavailable to the worker without authorizing a local test boundary, Autopilot parks it for a person with `pdd:needs-decision` and records a crisp skip reason."
    },
    {
      "id": "ac-sha256-1cf0e3d02c585741b7ea814e0c562580645edb9745d4192f",
      "text": "A valid single-repo bug or feature that mentions another service only for context, cites a pasted error log in a code fence, or can be verified with local tests passes pre-flight without being skipped."
    },
    {
      "id": "ac-sha256-29adaa40e7c26db82e612ad421af949b6a48b1d8c39be920",
      "text": "Recorded pre-flight skip reasons roll up into exact counts per reason category alongside Classifier Conversion (\"3/4 (75.0%)\" when 3 of 4 taken issues merged or reached would-merge, or \"0/0 (n/a)\" when 0 issues were taken) so metrics can report intake filter precision."
    }
  ],
