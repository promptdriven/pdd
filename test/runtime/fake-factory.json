{
  "entry_path": "examples/fakes/factory.prompt.md",
  "initial_world": {
    "instances": []
  },
  "simulation": {
    "instances.store": {
      "action": "collection.merge",
      "world_pointer": "/instances",
      "key_argument_pointer": "/handle",
      "value_argument_pointer": "/config",
      "item_key_pointer": "/handle",
      "item_value_pointer": "/config",
      "result_template": {
        "config": null
      },
      "result_value_pointer": "/config"
    },
    "instances.load": {
      "action": "collection.get",
      "world_pointer": "/instances",
      "key_argument_pointer": "/handle",
      "value_argument_pointer": null,
      "item_key_pointer": "/handle",
      "item_value_pointer": "/config",
      "result_template": {
        "config": null
      },
      "result_value_pointer": "/config"
    }
  },
  "steps": [
    {
      "id": "create",
      "op": "createGreeter",
      "input": {
        "prefix": "Hello "
      },
      "checks": {
        "1": [
          ["world", "/instances/0/config", "=", {"prefix": "Hello "}]
        ]
      }
    },
    {
      "id": "greet",
      "op": "greet",
      "input": {
        "handle": {
          "$step": "create#/handle"
        },
        "name": "Ada"
      },
      "checks": {
        "1": [
          ["result", "/text", "=", "Hello Ada"]
        ]
      }
    }
  ]
}
