      "key_argument_pointer": "/handle",
      "value_argument_pointer": "/config",
      "item_key_pointer": "/handle",
      "item_value_pointer": "/config",
      "result_template": {
        "config": null
      },
      "result_value_pointer": "/config"
    },
    "instances.load": {
      "action": "collection.get",
      "world_pointer": "/instances",
      "key_argument_pointer": "/handle",
      "value_argument_pointer": null,
      "item_key_pointer": "/handle",
      "item_value_pointer": "/config",
      "result_template": {
        "config": null
      },
      "result_value_pointer": "/config"
    }
  },
  "context": [],
  "steps": [
    {
      "step_id": "create",
      "entry_path": "examples/fakes/factory.prompt.md",
      "operation": "createGreeter",
      "input": {
        "prefix": "Hello "
      },
      "checks": [
        {
          "criterion_id": "AC1",
          "target": "world",
