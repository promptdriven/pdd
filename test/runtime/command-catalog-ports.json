    {
      "id": "AC1",
      "text": "`NAMES`, `BUNDLED_WORKFLOW_NAMES` and `PUBLIC_HELP_TEXT` return the canonical command words, bundled workflow list and help text templates."
    },
    {
      "id": "AC2",
      "text": "`PUBLIC_COMMAND_IDS`, `PUBLIC_COMMAND_ROUTES` and `PUBLIC_COMMAND_MANIFEST` return route membership, route specifications and help form descriptions for cataloged commands."
    },
    {
      "id": "AC3",
      "text": "Unknown keys, workflow names, help sections, route ids and help forms fail with `unknown-command-name`, `unknown-workflow-name`, `unknown-help-section`, `unknown-route-id` and `unknown-help-form`."
    }
  ],
