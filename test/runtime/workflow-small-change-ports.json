{
  "schema_version": "prompt-runtime.program-scenario.v1",
  "story_path": "user_stories/workflow-small-change-ports.md",
  "criteria": [
    {
      "id": "AC1",
      "text": "Reading a valid `small-change-checklist.json` under `runDir` whose `run_id` and `source.sha256` match the run and current `replay.sourceFingerprint` returns `status: \"recorded\"`, preserves item order, and reports `missing-evidence` for a `done` row with blank evidence."
    },
    {
      "id": "AC2",
      "text": "Reading a checklist whose `source.sha256` differs from `replay.sourceFingerprint` returns `status: \"stale\"` with `stale-checklist`, and passing an empty `runDir` fails with `invalid_checklist_run`."
    },
    {
      "id": "AC3",
      "text": "Reviewing a checklist against an independent request inventory matches rows by `source`, `request` and `quote`, reports `missing-request` for an omitted request and `unsupported-exclusion` when an excluded item's quote differs from the independent `exclusion_quote`, and rejects an empty `requests` array with `invalid_request_inventory`."
    }
  ],
  "initial_world": {
    "files": {
