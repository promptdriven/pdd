{
  "schema_version": "prompt-runtime.program-scenario.v1",
  "story_path": "user_stories/setup-phone-pairing.md",
  "criteria": [
    {
      "id": "AC1",
      "text": "`pdd setup --pair-code K7Q2-9MXD` shows that exact code for ten minutes and waits for a matching phone; ordinary interactive setup offers pairing when no phone is paired and, if accepted, generates and shows its own code."
    },
    {
      "id": "AC2",
      "text": "A matching signed offer saves the phone's public key for the current GitHub login only after the terminal confirms the same code; a declined, invalid, expired or mismatched offer saves no key."
    },
    {
      "id": "AC3",
      "text": "A local service can read pending code and paired public keys through `pdd pair status --json`, and submit an offer through `pdd pair offer --message FILE`; the offer command alone never saves a key or exposes a private key."
    },
    {
      "id": "AC4",
      "text": "A supplied code can pair an additional phone; invalid codes, a supplied code with `--yes` or `--no-pair`, and a supplied code without a terminal exit 2 before setup effects. Ordinary nonterminal setup skips pairing."
    }
  ],
