{
  "name": "@promptdriven/pdd",
  "version": "0.1.52",
  "description": "PDD: local Prompting guide, skills and recipes for your coding agent",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/promptdriven/pdd.git"
  },
  "homepage": "https://github.com/promptdriven/pdd#readme",
  "bugs": {
    "url": "https://github.com/promptdriven/pdd/issues"
  },
  "bin": {
    "pdd": "bin/pdd.mjs",
    "pdd-codex": "bin/pdd-codex.mjs",
    "pdd-claude": "bin/pdd-claude.mjs"
  },
  "files": [
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "AGENTS.md",
    "bin/",
    "src/",
    "docs/index.md",
    "docs/USAGE.md",
    "docs/cli.md",
    "docs/workflows.md",
    "docs/runtime-boundaries.md",
    "docs/build-a-whole-product.md",
    "docs/autopilot-factory.md",
    "docs/metrics.md",
    "docs/ISSUES.md",
    "docs/lint-capacity.md",
    "docs/runtime-bindings.md",
    "docs/runtime-interface-admission.md",
    "docs/prompt-reentry-verification.md",
    "skills/",
    "examples/",
    "test/runtime/fake-*.json",
    "user_stories/fake-*.md"
  ],
  "scripts": {
    "test": "files=$(node scripts/list-tests.mjs) && [ -n \"$files\" ] && node --import ./test/helpers/test-home.mjs --import ./test/helpers/test-net-guard.mjs --test $files",
    "lint:js": "oxlint -c .oxlintrc.json src bin",
    "check:arch": "oxlint -c .oxlintrc.json src bin && depcruise src bin --config .dependency-cruiser.cjs --ignore-known .dependency-cruiser-known-violations.json --output-type err-long",
    "version": "node scripts/sync-pypi-version.mjs && git add python/pyproject.toml python/pdd_cli/__init__.py",
    "release:publish": "node scripts/publish-release.mjs"
  },
  "dependencies": {
    "@promptdriven/runtime-client": "1.1.2"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "dependency-cruiser": "18.9.0",
    "oxlint": "1.95.0"
  }
}
