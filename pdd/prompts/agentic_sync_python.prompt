<pdd-reason>Global and GitHub issue-driven module identification plus parallel sync orchestration.</pdd-reason>

<pdd-interface>
{
  "type": "module",
  "module": {
    "functions": [
      {"name": "run_agentic_sync", "signature": "(issue_url: str, *, verbose: bool, quiet: bool, budget: Optional[float], skip_verify: bool, skip_tests: bool, dry_run: bool, agentic_mode: bool, no_steer: bool, max_attempts: Optional[int], timeout_adder: float, use_github_state: bool, one_session: bool, reasoning_time: Optional[float], durable: bool, durable_branch: Optional[str], no_resume: bool, durable_max_parallel: Optional[int], strength: Optional[float], temperature: Optional[float], context_override: Optional[str], compressed_context: bool = False, local: bool = False) -> Tuple[bool, str, float, str]", "returns": "Tuple[bool, str, float, str]"},
      {"name": "run_global_sync", "signature": "(*, verbose: bool, quiet: bool, budget: Optional[float], skip_verify: bool, skip_tests: bool, agentic_mode: bool, no_steer: bool, max_attempts: Optional[int], dry_run: bool, target_coverage: Optional[float], one_session: bool, local: bool, timeout_adder: float, strength: Optional[float], temperature: Optional[float], context_override: Optional[str], compressed_context: bool = False) -> Tuple[bool, str, float, str]", "returns": "Tuple[bool, str, float, str]"},
      {"name": "_is_github_issue_url", "signature": "(s: str) -> bool", "returns": "bool"},
      {"name": "_freeze_issue_sync_plan", "signature": "(project_root: Path, modules: List[str], module_cwds: Dict[str, Path], module_targets: Dict[str, str], dep_graph: Dict[str, List[str]], *, context_override: Optional[str] = None, provenance_source: str = 'issue_selection', inventory: Optional[SyncPlan] = None) -> SyncPlan", "returns": "SyncPlan"},
      {"name": "_parse_llm_response", "signature": "(response: str) -> Tuple[List[str], bool, List[Dict]]", "returns": "Tuple[List[str], bool, List[Dict]]"},
      {"name": "_parse_changed_modules_env", "signature": "(value: str) -> list[str]", "returns": "list[str]"}
    ]
  }
}
